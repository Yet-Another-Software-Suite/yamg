    }
  }

  /** Where the motor's rotor is for an arm angle. */
  private static Angle toMotorPosition(Angle armAngle) {
    return armAngle.times(GEAR_RATIO);
  }

  private Angle getMotorPosition() {
{{> getMotorPosition}}
  }

  private AngularVelocity getMotorVelocity() {
{{> getMotorVelocity}}
  }

  /** The arm's angle, from horizontal. */
  public Angle getAngle() {
    return getMotorPosition().div(GEAR_RATIO);
  }

  /** How fast the arm is turning. */
  public AngularVelocity getVelocity() {
    return getMotorVelocity().div(GEAR_RATIO);
  }

  /** The voltage the motor controller is applying to the motor. */
  public Voltage getVoltage() {
{{> getVoltage}}
  }

  /** The motor's stator current. */
  public Current getCurrent() {
{{> getCurrent}}
  }

  /** The motor's temperature. */
  public Temperature getTemperature() {
{{> getTemperature}}
  }

  private void setMotorPosition(Angle motorPosition, Voltage feedforward) {
{{> setMotorPosition}}
  }

  private void setMotorVoltage(Voltage voltage) {
{{> setMotorVoltage}}
  }

  /** Start moving the arm to an angle with the closed loop. */
  private void setGoal(Angle angle) {
    if (goal == null) {
      // Start the profile from where the arm is now.
      setpoint = new TrapezoidProfile.State(getAngle().in(Radians), getVelocity().in(RadiansPerSecond));
    }
    Angle clamped = angle.lt(MIN_ANGLE) ? MIN_ANGLE : angle.gt(MAX_ANGLE) ? MAX_ANGLE : angle;
    goal = new TrapezoidProfile.State(clamped.in(Radians), 0);
  }

  /** Go to an angle and hold it. This command does not end on its own. */
  public Command setAngle(Angle angle) {
    return run(() -> setGoal(angle)).withName("{{className}} Set Angle");
  }

  /** Drive the arm with a duty cycle from -1 to 1. The closed loop is not used. */
  public Command set(double dutyCycle) {
    return run(() -> {
      goal = null;
      setMotorVoltage(RobotController.getMeasureBatteryVoltage().times(dutyCycle));
    }).withName("{{className}} Set Duty Cycle");
  }

  /** True while the arm is within a tolerance of an angle. */
  public Trigger near(Angle angle, Angle tolerance) {
    return new Trigger(() -> getAngle().isNear(angle, tolerance));
  }

  @Override
  public void periodic() {
    if (goal != null) {
      // Step the profile one loop, and give the motor controller the next setpoint and feedforward.
      TrapezoidProfile.State next = profile.calculate(LOOP_PERIOD.in(Seconds), setpoint, goal);
      Voltage feedforwardVoltage = Volts.of(feedforward.calculate(setpoint.position, setpoint.velocity, next.velocity));
      setpoint = next;
      setMotorPosition(toMotorPosition(Radians.of(next.position)), feedforwardVoltage);
    }

{{#if logPosition}}
    Telemetry.log("{{ntKey}}/Angle", {{positionUnit}}.of(getAngle().in({{positionUnit}})));
{{/if}}
{{#if logVelocity}}
    Telemetry.log("{{ntKey}}/Velocity", getVelocity());
{{/if}}
{{#if logVoltage}}
    Telemetry.log("{{ntKey}}/Voltage", getVoltage());
{{/if}}
{{#if logCurrent}}
    Telemetry.log("{{ntKey}}/Current", getCurrent());
{{/if}}
{{#if logTemperature}}
    Telemetry.log("{{ntKey}}/Temperature", getTemperature());
{{/if}}
    armLigament.setAngle(getAngle().in(Degrees));
    Telemetry.log("{{ntKey}}/Mechanism", mechanism2d);
  }

  @Override
  public void simulationPeriodic() {
    Voltage batteryVoltage = RobotController.getMeasureBatteryVoltage();
{{> simPrepare}}
    armSim.setInputVoltage({{> simAppliedVoltage}}.in(Volts));
    armSim.update(LOOP_PERIOD.in(Seconds));
    AngularVelocity motorVelocity = RadiansPerSecond.of(armSim.getVelocity()).times(GEAR_RATIO);
{{> simUpdate}}
  }
