  // The arm's size, its physical limits, and where it is when the robot turns on.
  private static final Distance ARM_LENGTH = Meters.of({{armLength}});
  private static final Mass ARM_MASS = Kilograms.of({{mass}});
  private static final Angle MIN_ANGLE = Degrees.of({{hardLimitMin}});
  private static final Angle MAX_ANGLE = Degrees.of({{hardLimitMax}});
  private static final Angle STARTING_ANGLE = Degrees.of({{startingPosition}});
  private static final Angle STARTING_MECHANISM_POSITION = STARTING_ANGLE;
{{#if enableSoftLimits}}
  // The motor controller will not drive the arm past these angles.
  private static final Angle FORWARD_SOFT_LIMIT = Degrees.of({{forwardSoftLimit}});
  private static final Angle REVERSE_SOFT_LIMIT = Degrees.of({{reverseSoftLimit}});
{{/if}}

  // The fastest the closed loop moves the arm.
  private static final AngularVelocity MAX_VELOCITY = RadiansPerSecond.of({{maxVelocity}});
  private static final AngularAcceleration MAX_ACCELERATION = RadiansPerSecondPerSecond.of({{maxAcceleration}});
{{#if systemCoreProfile}}
  private final TrapezoidProfile profile = new TrapezoidProfile(
      new TrapezoidProfile.Constraints(MAX_VELOCITY.in(RadiansPerSecond), MAX_ACCELERATION.in(RadiansPerSecondPerSecond)));
{{/if}}

{{#if systemCoreProfile}}
{{#if onboardControl}}
  // Used only in simulation, for the part of the feedforward the SPARK does not apply in Position
  // mode: kV and kA, and gravity, since REVLib's simulated SPARK works kCos out from the setpoint in
  // degrees. The SPARK applies kS itself.
  private final ArmFeedforward feedforward = new ArmFeedforward(0, {{kG}}, {{kV}}, {{kA}});
{{else}}
  // Feedforward gains, in volts per radian per second (kV) and per radian per second squared (kA).
  private final ArmFeedforward feedforward = new ArmFeedforward({{kS}}, {{kG}}, {{kV}}, {{kA}});
{{/if}}
{{/if}}

