/**
 * A pivot, such as a turret or a wrist, driven by a {{motorDisplayName}} through a
 * {{controllerDisplayName}}. Generated by YAMG.
 *
 * <p>Gravity barely affects a pivot, so it has no gravity feedforward.
 */
public class {{className}} extends SubsystemBase {
  private static final int CAN_ID = {{canId}};
  private static final DCMotor DC_MOTOR = {{{dcMotor}}};
  /** Motor rotations per pivot rotation. */
  private static final double GEAR_RATIO = {{gearRatio}};
  private static final boolean BRAKE_MODE = {{brakeMode}};
{{#if enableStatorLimit}}
  private static final double STATOR_CURRENT_LIMIT = {{statorCurrentLimit}};
{{/if}}
{{#if enableSupplyLimit}}
  private static final double SUPPLY_CURRENT_LIMIT = {{supplyCurrentLimit}};
{{/if}}
{{#if enableOpenLoopRamp}}
  private static final double OPEN_LOOP_RAMP_SECONDS = {{openLoopRampRate}};
{{/if}}
{{#if enableClosedLoopRamp}}
  private static final double CLOSED_LOOP_RAMP_SECONDS = {{closedLoopRampRate}};
{{/if}}

  // Closed loop gains, in volts per {{gainUnit}} of error.
  private static final double KP = {{kP}};
  private static final double KI = {{kI}};
  private static final double KD = {{kD}};
  /** Motor rotations per {{gainUnit}} of the pivot, to convert the gains for the motor controller. */
  private static final double MOTOR_ROTATIONS_PER_GAIN_UNIT = GEAR_RATIO;

  // The pivot's physical limits and where it is when the robot turns on.
  private static final double PIVOT_LENGTH_METERS = {{armLength}};
  private static final double PIVOT_MASS_KG = {{mass}};
  private static final double MIN_ANGLE_RADIANS = Math.toRadians({{hardLimitMin}});
  private static final double MAX_ANGLE_RADIANS = Math.toRadians({{hardLimitMax}});
  private static final double STARTING_ANGLE_RADIANS = Math.toRadians({{startingPosition}});
  private static final double STARTING_MOTOR_ROTATIONS = toMotorRotations(STARTING_ANGLE_RADIANS);
{{#if enableSoftLimits}}
  // The motor controller will not drive the pivot past these angles.
  private static final double FORWARD_SOFT_LIMIT_MOTOR_ROTATIONS = toMotorRotations(Math.toRadians({{forwardSoftLimit}}));
  private static final double REVERSE_SOFT_LIMIT_MOTOR_ROTATIONS = toMotorRotations(Math.toRadians({{reverseSoftLimit}}));
{{/if}}

  // Feedforward gains, in volts per rotation per second (kV) and per rotation per second squared (kA).
  private final SimpleMotorFeedforward feedforward = new SimpleMotorFeedforward({{kS}}, {{kV}}, {{kA}});
  // The fastest the closed loop moves the pivot, in radians per second and per second squared.
  private final TrapezoidProfile profile =
      new TrapezoidProfile(new TrapezoidProfile.Constraints({{maxVelocity}}, {{maxAcceleration}}));

{{> fields}}

  // Where the closed loop is now, and where it is going. A null goal means the closed loop is off.
  private TrapezoidProfile.State setpoint = new TrapezoidProfile.State(STARTING_ANGLE_RADIANS, 0);
  private TrapezoidProfile.State goal = null;

  // The physics simulation of the pivot, and a drawing of it for a dashboard.
  private final SingleJointedArmSim pivotSim = new SingleJointedArmSim(
      DC_MOTOR, GEAR_RATIO, SingleJointedArmSim.estimateMOI(PIVOT_LENGTH_METERS, PIVOT_MASS_KG),
      PIVOT_LENGTH_METERS, MIN_ANGLE_RADIANS, MAX_ANGLE_RADIANS, false, STARTING_ANGLE_RADIANS);
{{> simFields}}
  private final Mechanism2d mechanism2d = new Mechanism2d(3 * PIVOT_LENGTH_METERS, 3 * PIVOT_LENGTH_METERS);
  private final MechanismLigament2d pivotLigament = mechanism2d
      .getRoot("Base", 1.5 * PIVOT_LENGTH_METERS, 1.5 * PIVOT_LENGTH_METERS)
      .append(new MechanismLigament2d("Pivot", PIVOT_LENGTH_METERS, Math.toDegrees(STARTING_ANGLE_RADIANS)));

  public {{className}}() {
{{> configure}}
    if (RobotBase.isSimulation()) {
{{> simInit}}
    }
  }

  private static double toMotorRotations(double radians) {
    return radians / (2 * Math.PI) * GEAR_RATIO;
  }

  private double getMotorRotations() {
{{> getMotorRotations}}
  }

  private double getMotorRPS() {
{{> getMotorRPS}}
  }

  /** The pivot's angle. */
  public Angle getAngle() {
    return Radians.of(getMotorRotations() / GEAR_RATIO * 2 * Math.PI);
  }

  /** How fast the pivot is turning. */
  public AngularVelocity getVelocity() {
    return RadiansPerSecond.of(getMotorRPS() / GEAR_RATIO * 2 * Math.PI);
  }

  /** The voltage the motor controller is applying to the motor. */
  public double getAppliedVolts() {
{{> getAppliedVolts}}
  }

  /** The motor's stator current, in amps. */
  public double getCurrent() {
{{> getCurrent}}
  }

  /** The motor's temperature, in degrees Celsius. */
  public double getTemperature() {
{{> getTemperature}}
  }

  private void setMotorPosition(double motorRotations, double feedforwardVolts) {
{{> setMotorPosition}}
  }

  private void setMotorVoltage(double volts) {
{{> setMotorVoltage}}
  }

  /** Start moving the pivot to an angle with the closed loop. */
  private void setGoal(Angle angle) {
    if (goal == null) {
      // Start the profile from where the pivot is now.
      setpoint = new TrapezoidProfile.State(getAngle().in(Radians), getVelocity().in(RadiansPerSecond));
    }
    double radians = Math.max(MIN_ANGLE_RADIANS, Math.min(MAX_ANGLE_RADIANS, angle.in(Radians)));
    goal = new TrapezoidProfile.State(radians, 0);
  }

  /** Go to an angle and hold it. This command does not end on its own. */
  public Command setAngle(Angle angle) {
    return run(() -> setGoal(angle)).withName("{{className}} Set Angle");
  }

  /** Drive the pivot with a duty cycle from -1 to 1. The closed loop is not used. */
  public Command set(double dutyCycle) {
    return run(() -> {
      goal = null;
      setMotorVoltage(dutyCycle * RobotController.getBatteryVoltage());
    }).withName("{{className}} Set Duty Cycle");
  }

  /** True while the pivot is within a tolerance of an angle. */
  public Trigger near(Angle angle, Angle tolerance) {
    return new Trigger(() -> getAngle().isNear(angle, tolerance));
  }

  @Override
  public void periodic() {
    if (goal != null) {
      // Step the profile one loop, and give the motor controller the next setpoint and feedforward.
      TrapezoidProfile.State next = profile.calculate(0.020, setpoint, goal);
      double feedforwardVolts = feedforward.calculate(setpoint.velocity / (2 * Math.PI), next.velocity / (2 * Math.PI));
      setpoint = next;
      setMotorPosition(toMotorRotations(next.position), feedforwardVolts);
    }

{{#if logPosition}}
    Telemetry.log("{{ntKey}}/Angle ({{positionUnit}})", getAngle().in({{positionUnit}}));
{{/if}}
{{#if logVelocity}}
    Telemetry.log("{{ntKey}}/Velocity (deg per s)", getVelocity().in(DegreesPerSecond));
{{/if}}
{{#if logVoltage}}
    Telemetry.log("{{ntKey}}/Applied Voltage", getAppliedVolts());
{{/if}}
{{#if logCurrent}}
    Telemetry.log("{{ntKey}}/Current", getCurrent());
{{/if}}
{{#if logTemperature}}
    Telemetry.log("{{ntKey}}/Temperature", getTemperature());
{{/if}}
    pivotLigament.setAngle(getAngle().in(Degrees));
    Telemetry.log("{{ntKey}}/Mechanism", mechanism2d);
  }

  @Override
  public void simulationPeriodic() {
    double batteryVolts = RobotController.getBatteryVoltage();
{{> simPrepare}}
    pivotSim.setInputVoltage({{> simAppliedVolts}});
    pivotSim.update(0.020);
    double motorRPS = pivotSim.getVelocity() / (2 * Math.PI) * GEAR_RATIO;
{{> simUpdate}}
  }
}
