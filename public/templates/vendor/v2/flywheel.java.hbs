/**
 * A flywheel, such as a shooter, driven by a {{motorDisplayName}} through a
 * {{controllerDisplayName}}. Generated by YAMG.
 */
public class {{className}} extends SubsystemBase {
  private static final int CAN_ID = {{canId}};
  private static final DCMotor DC_MOTOR = {{{dcMotor}}};
  /** Motor rotations per flywheel rotation. */
  private static final double GEAR_RATIO = {{gearRatio}};
  private static final MomentOfInertia MOMENT_OF_INERTIA = KilogramSquareMeters.of({{momentOfInertia}});
  private static final boolean BRAKE_MODE = {{brakeMode}};
{{#if enableStatorLimit}}
  private static final Current STATOR_CURRENT_LIMIT = Amps.of({{statorCurrentLimit}});
{{/if}}
{{#if enableSupplyLimit}}
  private static final Current SUPPLY_CURRENT_LIMIT = Amps.of({{supplyCurrentLimit}});
{{/if}}
{{#if enableOpenLoopRamp}}
  private static final Time OPEN_LOOP_RAMP = Seconds.of({{openLoopRampRate}});
{{/if}}
{{#if enableClosedLoopRamp}}
  private static final Time CLOSED_LOOP_RAMP = Seconds.of({{closedLoopRampRate}});
{{/if}}
  /** How often the robot loop runs. */
  private static final Time LOOP_PERIOD = Seconds.of(0.020);
  /** The flywheel starts at rest, with its encoder at zero. */
  private static final Angle STARTING_MOTOR_POSITION = Rotations.of(0);

  // Closed loop gains, in volts per {{gainUnit}} of error.
  private static final double KP = {{kP}};
  private static final double KI = {{kI}};
  private static final double KD = {{kD}};

  // Feedforward gains, in volts per rotation per second (kV) and per rotation per second squared (kA).
  private final SimpleMotorFeedforward feedforward = new SimpleMotorFeedforward({{kS}}, {{kV}}, {{kA}});

{{> fields}}

  // The speed the closed loop holds. Null means the closed loop is off.
  private AngularVelocity goalVelocity = null;

  // The physics simulation of the flywheel, and a drawing of it for a dashboard.
  private final FlywheelSim flywheelSim = new FlywheelSim(
      Models.flywheelFromPhysicalConstants(DC_MOTOR, MOMENT_OF_INERTIA.in(KilogramSquareMeters), GEAR_RATIO), DC_MOTOR);
{{> simFields}}
  private final Mechanism2d mechanism2d = new Mechanism2d(1, 1);
  private final MechanismLigament2d spokeLigament = mechanism2d
      .getRoot("Axle", 0.5, 0.5)
      .append(new MechanismLigament2d("Flywheel", 0.4, 0));

  public {{className}}() {
{{> configure}}
    if (RobotBase.isSimulation()) {
{{> simInit}}
    }
  }

  private Angle getMotorPosition() {
{{> getMotorPosition}}
  }

  private AngularVelocity getMotorVelocity() {
{{> getMotorVelocity}}
  }

  /** How fast the flywheel is spinning. */
  public AngularVelocity getVelocity() {
    return getMotorVelocity().div(GEAR_RATIO);
  }

  /** The voltage the motor controller is applying to the motor. */
  public Voltage getVoltage() {
{{> getVoltage}}
  }

  /** The motor's stator current. */
  public Current getCurrent() {
{{> getCurrent}}
  }

  /** The motor's temperature. */
  public Temperature getTemperature() {
{{> getTemperature}}
  }

  private void setMotorVelocity(AngularVelocity motorVelocity, Voltage feedforward) {
{{> setMotorVelocity}}
  }

  private void setMotorVoltage(Voltage voltage) {
{{> setMotorVoltage}}
  }

  /** Spin at a speed and hold it. This command does not end on its own. */
  public Command setVelocity(AngularVelocity velocity) {
    return run(() -> goalVelocity = velocity).withName("{{className}} Set Velocity");
  }

  /** Drive the flywheel with a duty cycle from -1 to 1. The closed loop is not used. */
  public Command set(double dutyCycle) {
    return run(() -> {
      goalVelocity = null;
      setMotorVoltage(RobotController.getMeasureBatteryVoltage().times(dutyCycle));
    }).withName("{{className}} Set Duty Cycle");
  }

  /** True while the flywheel is within a tolerance of a speed. */
  public Trigger near(AngularVelocity velocity, AngularVelocity tolerance) {
    return new Trigger(() -> getVelocity().isNear(velocity, tolerance));
  }

  @Override
  public void periodic() {
    if (goalVelocity != null) {
      // The feedforward does most of the work, and the closed loop corrects what is left.
      Voltage feedforwardVoltage = Volts.of(feedforward.calculate(goalVelocity.in(RotationsPerSecond)));
      setMotorVelocity(goalVelocity.times(GEAR_RATIO), feedforwardVoltage);
    }

{{#if logVelocity}}
    Telemetry.log("{{ntKey}}/Velocity", RPM.of(getVelocity().in(RPM)));
{{/if}}
{{#if logVoltage}}
    Telemetry.log("{{ntKey}}/Voltage", getVoltage());
{{/if}}
{{#if logCurrent}}
    Telemetry.log("{{ntKey}}/Current", getCurrent());
{{/if}}
{{#if logTemperature}}
    Telemetry.log("{{ntKey}}/Temperature", getTemperature());
{{/if}}
    // Turn the spoke with the flywheel, so that the drawing shows it spinning.
    spokeLigament.setAngle(getMotorPosition().div(GEAR_RATIO).in(Rotations) * 360 % 360);
    Telemetry.log("{{ntKey}}/Mechanism", mechanism2d);
  }

  @Override
  public void simulationPeriodic() {
    Voltage batteryVoltage = RobotController.getMeasureBatteryVoltage();
{{> simPrepare}}
    flywheelSim.setInputVoltage({{> simAppliedVoltage}}.in(Volts));
    flywheelSim.update(LOOP_PERIOD.in(Seconds));
    AngularVelocity motorVelocity = RadiansPerSecond.of(flywheelSim.getAngularVelocity()).times(GEAR_RATIO);
{{> simUpdate}}
  }
}
