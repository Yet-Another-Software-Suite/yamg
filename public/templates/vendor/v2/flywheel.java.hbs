package first.robot.subsystems;

import static org.wpilib.units.Units.RPM;
import static org.wpilib.units.Units.RotationsPerSecond;

{{> imports}}
import org.wpilib.command2.Command;
import org.wpilib.command2.SubsystemBase;
import org.wpilib.command2.button.Trigger;
import org.wpilib.framework.RobotBase;
import org.wpilib.math.controller.SimpleMotorFeedforward;
import org.wpilib.math.system.DCMotor;
import org.wpilib.math.system.Models;
import org.wpilib.simulation.FlywheelSim;
import org.wpilib.smartdashboard.Mechanism2d;
import org.wpilib.smartdashboard.MechanismLigament2d;
import org.wpilib.system.RobotController;
import org.wpilib.telemetry.Telemetry;
import org.wpilib.units.measure.AngularVelocity;

/**
 * A flywheel, such as a shooter, driven by a {{motorDisplayName}} through a
 * {{controllerDisplayName}}. Generated by YAMG.
 */
public class {{className}} extends SubsystemBase {
  private static final int CAN_ID = {{canId}};
  private static final DCMotor DC_MOTOR = {{{dcMotor}}};
  /** Motor rotations per flywheel rotation. */
  private static final double GEAR_RATIO = {{gearRatio}};
  /** The flywheel's moment of inertia, in kilogram square meters. */
  private static final double MOMENT_OF_INERTIA = {{momentOfInertia}};
  private static final boolean BRAKE_MODE = {{brakeMode}};
{{#if enableStatorLimit}}
  private static final double STATOR_CURRENT_LIMIT = {{statorCurrentLimit}};
{{/if}}
{{#if enableSupplyLimit}}
  private static final double SUPPLY_CURRENT_LIMIT = {{supplyCurrentLimit}};
{{/if}}
{{#if enableOpenLoopRamp}}
  private static final double OPEN_LOOP_RAMP_SECONDS = {{openLoopRampRate}};
{{/if}}
{{#if enableClosedLoopRamp}}
  private static final double CLOSED_LOOP_RAMP_SECONDS = {{closedLoopRampRate}};
{{/if}}
  /** The flywheel starts at rest, with its encoder at zero. */
  private static final double STARTING_MOTOR_ROTATIONS = 0.0;

  // Closed loop gains, in volts per {{gainUnit}} of error.
  private static final double KP = {{kP}};
  private static final double KI = {{kI}};
  private static final double KD = {{kD}};

  // Feedforward gains, in volts per rotation per second (kV) and per rotation per second squared (kA).
  private final SimpleMotorFeedforward feedforward = new SimpleMotorFeedforward({{kS}}, {{kV}}, {{kA}});

{{> fields}}

  // The speed the closed loop holds, in flywheel rotations per second. Null means the closed loop is off.
  private Double goalRPS = null;

  // The physics simulation of the flywheel, and a drawing of it for a dashboard.
  private final FlywheelSim flywheelSim = new FlywheelSim(
      Models.flywheelFromPhysicalConstants(DC_MOTOR, MOMENT_OF_INERTIA, GEAR_RATIO), DC_MOTOR);
{{> simFields}}
  private final Mechanism2d mechanism2d = new Mechanism2d(1, 1);
  private final MechanismLigament2d spokeLigament = mechanism2d
      .getRoot("Axle", 0.5, 0.5)
      .append(new MechanismLigament2d("Flywheel", 0.4, 0));

  public {{className}}() {
{{> configure}}
    if (RobotBase.isSimulation()) {
{{> simInit}}
    }
  }

  private double getMotorRotations() {
{{> getMotorRotations}}
  }

  private double getMotorRPS() {
{{> getMotorRPS}}
  }

  /** How fast the flywheel is spinning. */
  public AngularVelocity getVelocity() {
    return RotationsPerSecond.of(getMotorRPS() / GEAR_RATIO);
  }

  /** The voltage the motor controller is applying to the motor. */
  public double getAppliedVolts() {
{{> getAppliedVolts}}
  }

  /** The motor's stator current, in amps. */
  public double getCurrent() {
{{> getCurrent}}
  }

  /** The motor's temperature, in degrees Celsius. */
  public double getTemperature() {
{{> getTemperature}}
  }

  private void setMotorVelocity(double motorRPS, double feedforwardVolts) {
{{> setMotorVelocity}}
  }

  private void setMotorVoltage(double volts) {
{{> setMotorVoltage}}
  }

  /** Spin at a speed and hold it. This command does not end on its own. */
  public Command setVelocity(AngularVelocity velocity) {
    return run(() -> goalRPS = velocity.in(RotationsPerSecond)).withName("{{className}} Set Velocity");
  }

  /** Drive the flywheel with a duty cycle from -1 to 1. The closed loop is not used. */
  public Command set(double dutyCycle) {
    return run(() -> {
      goalRPS = null;
      setMotorVoltage(dutyCycle * RobotController.getBatteryVoltage());
    }).withName("{{className}} Set Duty Cycle");
  }

  /** True while the flywheel is within a tolerance of a speed. */
  public Trigger near(AngularVelocity velocity, AngularVelocity tolerance) {
    return new Trigger(() -> getVelocity().isNear(velocity, tolerance));
  }

  @Override
  public void periodic() {
    if (goalRPS != null) {
      // The feedforward does most of the work, and the closed loop corrects what is left.
      setMotorVelocity(goalRPS * GEAR_RATIO, feedforward.calculate(goalRPS));
    }

{{#if logVelocity}}
    Telemetry.log("{{ntKey}}/Velocity (RPM)", getVelocity().in(RPM));
{{/if}}
{{#if logVoltage}}
    Telemetry.log("{{ntKey}}/Applied Voltage", getAppliedVolts());
{{/if}}
{{#if logCurrent}}
    Telemetry.log("{{ntKey}}/Current", getCurrent());
{{/if}}
{{#if logTemperature}}
    Telemetry.log("{{ntKey}}/Temperature", getTemperature());
{{/if}}
    // Turn the spoke with the flywheel, so that the drawing shows it spinning.
    spokeLigament.setAngle(getMotorRotations() / GEAR_RATIO * 360 % 360);
    Telemetry.log("{{ntKey}}/Mechanism", mechanism2d);
  }

  @Override
  public void simulationPeriodic() {
    double batteryVolts = RobotController.getBatteryVoltage();
{{> simPrepare}}
    flywheelSim.setInputVoltage({{> simAppliedVolts}});
    flywheelSim.update(0.020);
    double motorRPS = flywheelSim.getAngularVelocity() / (2 * Math.PI) * GEAR_RATIO;
{{> simUpdate}}
  }
}
