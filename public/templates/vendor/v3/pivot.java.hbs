  /** Start moving the pivot to an angle with the closed loop. */
  private void setGoal(Angle angle) {
{{#if systemCoreProfile}}
    if (goal == null) {
      // Start the profile from where the pivot is now.
      setpoint = new TrapezoidProfile.State(getAngle().in(Radians), getVelocity().in(RadiansPerSecond));
    }
{{/if}}
    Angle clamped = angle.lt(MIN_ANGLE) ? MIN_ANGLE : angle.gt(MAX_ANGLE) ? MAX_ANGLE : angle;
{{#if sendGoalOnce}}
    if (goal == null || !clamped.isEquivalent(goal)) {
      // The Talon runs the {{#if useProfile}}profile{{else}}closed loop{{/if}} itself, so it only needs the goal when it changes.
      setMechanismGoal(clamped);
    }
{{/if}}
    goal = clamped;
  }

  /** The angle the closed loop is moving the pivot to, or empty while the closed loop is off. */
  public Optional<Angle> getGoal() {
    return Optional.ofNullable(goal);
  }

  /** Go to an angle and hold it. This command does not end on its own. */
  public Command setAngle(Angle angle) {
    return run(coroutine -> {
      while (true) {
        setGoal(angle);
        coroutine.yield();
      }
    }).named("{{className}} Set Angle");
  }

  /** Drive the pivot with a duty cycle from -1 to 1. The closed loop is not used. */
  public Command set(double dutyCycle) {
    return run(coroutine -> {
      goal = null;
      while (true) {
        setMotorVoltage(RobotController.getMeasureBatteryVoltage().times(dutyCycle));
        coroutine.yield();
      }
    }).named("{{className}} Set Duty Cycle");
  }

  /** True while the pivot is within a tolerance of an angle. */
  public Trigger near(Angle angle, Angle tolerance) {
    return new Trigger(() -> getAngle().isNear(angle, tolerance));
  }

  /** Hold an angle at the lowest priority, so that any other command for this mechanism can interrupt it. */
  public Command hold(Angle angle) {
    return run(coroutine -> {
      while (true) {
        setGoal(angle);
        coroutine.yield();
      }
    }).withPriority(Command.LOWEST_PRIORITY).named("{{className}} Hold");
  }

{{> homingMethods}}
  /** Call this from Robot.robotPeriodic(), before the scheduler runs. */
  public void periodic() {
{{> homingPeriodic}}
{{#unless sendGoalOnce}}
    if (goal != null) {
{{#if onboardControl}}
{{#if systemCoreProfile}}
      if (RobotBase.isSimulation()) {
        // REVLib's simulated SPARK applies the onboard feedforward, but its MAXMotion profile neither
        // keeps to the acceleration nor stops at the goal, so in simulation the profile runs here.
        // Step the profile one loop, and give the motor controller the next setpoint and feedforward.
        TrapezoidProfile.State next = profile.calculate(LOOP_PERIOD.in(Seconds), setpoint, new TrapezoidProfile.State(goal.in(Radians), 0));
        Voltage feedforwardVoltage = Volts.of(feedforward.calculate(
            RadiansPerSecond.of(setpoint.velocity).in(RotationsPerSecond), RadiansPerSecond.of(next.velocity).in(RotationsPerSecond)));
        setpoint = next;
        setMechanismPosition(Radians.of(next.position), feedforwardVoltage);
      } else {
        // The motor controller runs the trapezoidal profile and the feedforward itself.
        setMechanismGoal(goal);
      }
{{else}}
      // The motor controller runs the {{#if useProfile}}trapezoidal profile{{else}}closed loop{{/if}} and the feedforward itself.
      setMechanismGoal(goal);
{{/if}}
{{else if systemCoreProfile}}
      // Step the profile one loop, and give the motor controller the next setpoint and feedforward.
      TrapezoidProfile.State next = profile.calculate(LOOP_PERIOD.in(Seconds), setpoint, new TrapezoidProfile.State(goal.in(Radians), 0));
      Voltage feedforwardVoltage = Volts.of(feedforward.calculate(
          RadiansPerSecond.of(setpoint.velocity).in(RotationsPerSecond), RadiansPerSecond.of(next.velocity).in(RotationsPerSecond)));
      setpoint = next;
      setMechanismPosition(Radians.of(next.position), feedforwardVoltage);
{{else}}
      // Go straight to the goal, with the feedforward that holds it there.
      setMechanismPosition(goal, Volts.of(feedforward.calculate(0)));
{{/if}}
    }
{{/unless}}

    pivotLigament.setAngle(getAngle().in(Degrees));
{{#if useEpilogue}}
    if (goal != null) {
      loggedGoal = goal;
    }
{{/if}}
{{#unless useEpilogue}}
    // The goal is published only while the closed loop has one, as YAMS's telemetry does.
    if (goal != null) {
      Telemetry.log("{{ntKey}}/Goal", goal);
    }
{{#if logPosition}}
    Telemetry.log("{{ntKey}}/Angle", getAngle());
{{/if}}
{{#if logVelocity}}
    Telemetry.log("{{ntKey}}/Velocity", getVelocity());
{{/if}}
{{#if logVoltage}}
    Telemetry.log("{{ntKey}}/Voltage", getVoltage());
{{/if}}
{{#if logCurrent}}
    Telemetry.log("{{ntKey}}/Current", getCurrent());
{{/if}}
{{#if logTemperature}}
    Telemetry.log("{{ntKey}}/Temperature", getTemperature());
{{/if}}
    Telemetry.log("{{ntKey}}/Mechanism", mechanism2d);
{{> encoderTelemetry}}
{{/unless}}
  }

  /** Call this from Robot.simulationPeriodic(). */
  public void simulationPeriodic() {
    Voltage batteryVoltage = RobotController.getMeasureBatteryVoltage();
{{> simPrepare}}
    pivotSim.setInputVoltage({{> simAppliedVoltage}}.in(Volts));
    pivotSim.update(LOOP_PERIOD.in(Seconds));
    Angle mechanismPosition = Radians.of(pivotSim.getAngle());
    AngularVelocity mechanismVelocity = RadiansPerSecond.of(pivotSim.getVelocity());
    AngularAcceleration mechanismAcceleration = mechanismVelocity.minus(lastMechanismVelocity).div(LOOP_PERIOD);
    lastMechanismVelocity = mechanismVelocity;
{{> simUpdate}}
{{> homingSim}}
  }
