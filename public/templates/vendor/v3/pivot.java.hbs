/**
 * A pivot, such as a turret or a wrist, driven by a {{motorDisplayName}} through a
 * {{controllerDisplayName}}. Generated by YAMG.
 *
 * <p>Gravity barely affects a pivot, so it has no gravity feedforward.
{{#if useEpilogue}}
 *
 * <p>Epilogue logs the getters marked {@code @Logged}. Mark the class that holds this one {@code
 * @Logged} too, and bind Epilogue to the robot.
{{/if}}
 */
{{#if useEpilogue}}
@Logged(name = "{{ntKey}}", strategy = Logged.Strategy.OPT_IN)
{{/if}}
public class {{className}} implements Mechanism {
  private static final int CAN_ID = {{canId}};
  private static final DCMotor DC_MOTOR = {{{dcMotor}}};
  /** Motor rotations per pivot rotation. */
  private static final double GEAR_RATIO = {{gearRatio}};
  private static final boolean BRAKE_MODE = {{brakeMode}};
{{#if enableStatorLimit}}
  private static final Current STATOR_CURRENT_LIMIT = Amps.of({{statorCurrentLimit}});
{{/if}}
{{#if enableSupplyLimit}}
  private static final Current SUPPLY_CURRENT_LIMIT = Amps.of({{supplyCurrentLimit}});
{{/if}}
{{#if enableOpenLoopRamp}}
  private static final Time OPEN_LOOP_RAMP = Seconds.of({{openLoopRampRate}});
{{/if}}
{{#if enableClosedLoopRamp}}
  private static final Time CLOSED_LOOP_RAMP = Seconds.of({{closedLoopRampRate}});
{{/if}}
  /** How often the robot loop runs. */
  private static final Time LOOP_PERIOD = Seconds.of(0.020);

  // Closed loop gains, in volts per {{gainUnit}} of error.
  private static final double KP = {{kP}};
  private static final double KI = {{kI}};
  private static final double KD = {{kD}};
  /** Motor rotations per {{gainUnit}} of the pivot, to convert the gains for the motor controller. */
  private static final double MOTOR_ROTATIONS_PER_GAIN_UNIT = GEAR_RATIO;

  // The pivot's size, its physical limits, and where it is when the robot turns on.
  private static final Distance PIVOT_LENGTH = Meters.of({{armLength}});
  private static final Mass PIVOT_MASS = Kilograms.of({{mass}});
  private static final Angle MIN_ANGLE = Degrees.of({{hardLimitMin}});
  private static final Angle MAX_ANGLE = Degrees.of({{hardLimitMax}});
  private static final Angle STARTING_ANGLE = Degrees.of({{startingPosition}});
  private static final Angle STARTING_MOTOR_POSITION = toMotorPosition(STARTING_ANGLE);
{{#if enableSoftLimits}}
  // The motor controller will not drive the pivot past these angles.
  private static final Angle FORWARD_SOFT_LIMIT = toMotorPosition(Degrees.of({{forwardSoftLimit}}));
  private static final Angle REVERSE_SOFT_LIMIT = toMotorPosition(Degrees.of({{reverseSoftLimit}}));
{{/if}}

  // The fastest the closed loop moves the pivot.
  private static final AngularVelocity MAX_VELOCITY = RadiansPerSecond.of({{maxVelocity}});
  private static final AngularAcceleration MAX_ACCELERATION = RadiansPerSecondPerSecond.of({{maxAcceleration}});
  private final TrapezoidProfile profile = new TrapezoidProfile(
      new TrapezoidProfile.Constraints(MAX_VELOCITY.in(RadiansPerSecond), MAX_ACCELERATION.in(RadiansPerSecondPerSecond)));

  // Feedforward gains, in volts per rotation per second (kV) and per rotation per second squared (kA).
  private final SimpleMotorFeedforward feedforward = new SimpleMotorFeedforward({{kS}}, {{kV}}, {{kA}});

{{> fields}}

  // Where the closed loop is now, and where it is going, in radians. A null goal means the closed loop is off.
  private TrapezoidProfile.State setpoint = new TrapezoidProfile.State(STARTING_ANGLE.in(Radians), 0);
  private TrapezoidProfile.State goal = null;

  // The physics simulation of the pivot, and a drawing of it for a dashboard.
  private final SingleJointedArmSim pivotSim = new SingleJointedArmSim(
      DC_MOTOR, GEAR_RATIO, SingleJointedArmSim.estimateMOI(PIVOT_LENGTH.in(Meters), PIVOT_MASS.in(Kilograms)),
      PIVOT_LENGTH.in(Meters), MIN_ANGLE.in(Radians), MAX_ANGLE.in(Radians), false, STARTING_ANGLE.in(Radians));
{{> simFields}}
{{#if useEpilogue}}
  @Logged(name = "Mechanism")
{{/if}}
  private final Mechanism2d mechanism2d = new Mechanism2d(3 * PIVOT_LENGTH.in(Meters), 3 * PIVOT_LENGTH.in(Meters));
  private final MechanismLigament2d pivotLigament = mechanism2d
      .getRoot("Base", 1.5 * PIVOT_LENGTH.in(Meters), 1.5 * PIVOT_LENGTH.in(Meters))
      .append(new MechanismLigament2d("Pivot", PIVOT_LENGTH.in(Meters), STARTING_ANGLE.in(Degrees)));

  public {{className}}() {
{{> configure}}
    if (RobotBase.isSimulation()) {
{{> simInit}}
    }
  }

  /** Where the motor's rotor is for a pivot angle. */
  private static Angle toMotorPosition(Angle pivotAngle) {
    return pivotAngle.times(GEAR_RATIO);
  }

  private Angle getMotorPosition() {
{{> getMotorPosition}}
  }

  private AngularVelocity getMotorVelocity() {
{{> getMotorVelocity}}
  }

  /** The pivot's angle. */
{{#if (and useEpilogue logPosition)}}
  @Logged(name = "Angle")
{{/if}}
  public Angle getAngle() {
    return getMotorPosition().div(GEAR_RATIO);
  }

  /** How fast the pivot is turning. */
{{#if (and useEpilogue logVelocity)}}
  @Logged(name = "Velocity")
{{/if}}
  public AngularVelocity getVelocity() {
    return getMotorVelocity().div(GEAR_RATIO);
  }

  /** The voltage the motor controller is applying to the motor. */
{{#if (and useEpilogue logVoltage)}}
  @Logged(name = "Voltage")
{{/if}}
  public Voltage getVoltage() {
{{> getVoltage}}
  }

  /** The motor's stator current. */
{{#if (and useEpilogue logCurrent)}}
  @Logged(name = "Current")
{{/if}}
  public Current getCurrent() {
{{> getCurrent}}
  }

  /** The motor's temperature. */
{{#if (and useEpilogue logTemperature)}}
  @Logged(name = "Temperature")
{{/if}}
  public Temperature getTemperature() {
{{> getTemperature}}
  }

  private void setMotorPosition(Angle motorPosition, Voltage feedforward) {
{{> setMotorPosition}}
  }

  private void setMotorVoltage(Voltage voltage) {
{{> setMotorVoltage}}
  }

  /** Start moving the pivot to an angle with the closed loop. */
  private void setGoal(Angle angle) {
    if (goal == null) {
      // Start the profile from where the pivot is now.
      setpoint = new TrapezoidProfile.State(getAngle().in(Radians), getVelocity().in(RadiansPerSecond));
    }
    Angle clamped = angle.lt(MIN_ANGLE) ? MIN_ANGLE : angle.gt(MAX_ANGLE) ? MAX_ANGLE : angle;
    goal = new TrapezoidProfile.State(clamped.in(Radians), 0);
  }

  /** Go to an angle and hold it. This command does not end on its own. */
  public Command setAngle(Angle angle) {
    return run(coroutine -> {
      while (true) {
        setGoal(angle);
        coroutine.yield();
      }
    }).named("{{className}} Set Angle");
  }

  /** Drive the pivot with a duty cycle from -1 to 1. The closed loop is not used. */
  public Command set(double dutyCycle) {
    return run(coroutine -> {
      goal = null;
      while (true) {
        setMotorVoltage(RobotController.getMeasureBatteryVoltage().times(dutyCycle));
        coroutine.yield();
      }
    }).named("{{className}} Set Duty Cycle");
  }

  /** True while the pivot is within a tolerance of an angle. */
  public Trigger near(Angle angle, Angle tolerance) {
    return new Trigger(() -> getAngle().isNear(angle, tolerance));
  }

  /** Hold an angle at the lowest priority, so that any other command for this mechanism can interrupt it. */
  public Command hold(Angle angle) {
    return run(coroutine -> {
      while (true) {
        setGoal(angle);
        coroutine.yield();
      }
    }).withPriority(Command.LOWEST_PRIORITY).named("{{className}} Hold");
  }

  /** Call this from Robot.robotPeriodic(), before the scheduler runs. */
  public void periodic() {
    if (goal != null) {
      // Step the profile one loop, and give the motor controller the next setpoint and feedforward.
      TrapezoidProfile.State next = profile.calculate(LOOP_PERIOD.in(Seconds), setpoint, goal);
      Voltage feedforwardVoltage = Volts.of(feedforward.calculate(
          RadiansPerSecond.of(setpoint.velocity).in(RotationsPerSecond), RadiansPerSecond.of(next.velocity).in(RotationsPerSecond)));
      setpoint = next;
      setMotorPosition(toMotorPosition(Radians.of(next.position)), feedforwardVoltage);
    }

    pivotLigament.setAngle(getAngle().in(Degrees));
{{#unless useEpilogue}}
{{#if logPosition}}
    Telemetry.log("{{ntKey}}/Angle", getAngle());
{{/if}}
{{#if logVelocity}}
    Telemetry.log("{{ntKey}}/Velocity", getVelocity());
{{/if}}
{{#if logVoltage}}
    Telemetry.log("{{ntKey}}/Voltage", getVoltage());
{{/if}}
{{#if logCurrent}}
    Telemetry.log("{{ntKey}}/Current", getCurrent());
{{/if}}
{{#if logTemperature}}
    Telemetry.log("{{ntKey}}/Temperature", getTemperature());
{{/if}}
    Telemetry.log("{{ntKey}}/Mechanism", mechanism2d);
{{/unless}}
  }

  /** Call this from Robot.simulationPeriodic(). */
  public void simulationPeriodic() {
    Voltage batteryVoltage = RobotController.getMeasureBatteryVoltage();
{{> simPrepare}}
    pivotSim.setInputVoltage({{> simAppliedVoltage}}.in(Volts));
    pivotSim.update(LOOP_PERIOD.in(Seconds));
    AngularVelocity motorVelocity = RadiansPerSecond.of(pivotSim.getVelocity()).times(GEAR_RATIO);
{{> simUpdate}}
  }
}
