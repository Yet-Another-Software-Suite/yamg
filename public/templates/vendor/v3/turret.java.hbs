{{#if systemCoreProfile}}
  // Where WPILib's profile is now, in radians.
  private TrapezoidProfile.State setpoint = new TrapezoidProfile.State(STARTING_ANGLE.in(Radians), 0);
{{/if}}
  // Where the closed loop is going. Null means the closed loop is off.
  private Angle goal = null;

  // The physics simulation of the turret, and a drawing of it for a dashboard.
  private final SingleJointedArmSim turretSim = new SingleJointedArmSim(
      DC_MOTOR, GEAR_RATIO, SingleJointedArmSim.estimateMOI(TURRET_LENGTH.in(Meters), TURRET_MASS.in(Kilograms)),
      TURRET_LENGTH.in(Meters), MIN_ANGLE.in(Radians), MAX_ANGLE.in(Radians), false, STARTING_ANGLE.in(Radians));
{{> simFields}}
  // The simulated speed last loop, to work out the acceleration.
  private AngularVelocity lastMechanismVelocity = RotationsPerSecond.of(0);
{{#if useEpilogue}}
  @Logged(name = "Mechanism")
{{/if}}
  private final Mechanism2d mechanism2d = new Mechanism2d(3 * TURRET_LENGTH.in(Meters), 3 * TURRET_LENGTH.in(Meters));
  private final MechanismLigament2d turretLigament = mechanism2d
      .getRoot("Base", 1.5 * TURRET_LENGTH.in(Meters), 1.5 * TURRET_LENGTH.in(Meters))
      .append(new MechanismLigament2d("Turret", TURRET_LENGTH.in(Meters), STARTING_ANGLE.in(Degrees)));

