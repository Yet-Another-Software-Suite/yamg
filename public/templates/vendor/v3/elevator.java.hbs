/**
 * An elevator driven by a {{motorDisplayName}} through a {{controllerDisplayName}}. Generated by
 * YAMG.
 *
 * <p>Heights are in meters, measured by how far the drum has wound in the rope or belt.
 */
public class {{className}} implements Mechanism {
  private static final int CAN_ID = {{canId}};
  private static final DCMotor DC_MOTOR = {{{dcMotor}}};
  /** Motor rotations per drum rotation. */
  private static final double GEAR_RATIO = {{gearRatio}};
  /** The radius of the drum, or of the sprocket or pulley, that lifts the carriage. */
  private static final double DRUM_RADIUS_METERS = {{drumRadius}};
  private static final boolean BRAKE_MODE = {{brakeMode}};
{{#if enableStatorLimit}}
  private static final double STATOR_CURRENT_LIMIT = {{statorCurrentLimit}};
{{/if}}
{{#if enableSupplyLimit}}
  private static final double SUPPLY_CURRENT_LIMIT = {{supplyCurrentLimit}};
{{/if}}
{{#if enableOpenLoopRamp}}
  private static final double OPEN_LOOP_RAMP_SECONDS = {{openLoopRampRate}};
{{/if}}
{{#if enableClosedLoopRamp}}
  private static final double CLOSED_LOOP_RAMP_SECONDS = {{closedLoopRampRate}};
{{/if}}

  // Closed loop gains, in volts per {{gainUnit}} of error.
  private static final double KP = {{kP}};
  private static final double KI = {{kI}};
  private static final double KD = {{kD}};
  /** Motor rotations per meter of travel, to convert the gains for the motor controller. */
  private static final double MOTOR_ROTATIONS_PER_GAIN_UNIT = GEAR_RATIO / (2 * Math.PI * DRUM_RADIUS_METERS);

  // The elevator's physical limits and where it is when the robot turns on.
  private static final double CARRIAGE_MASS_KG = {{mass}};
  private static final double MIN_HEIGHT_METERS = {{hardLimitMin}};
  private static final double MAX_HEIGHT_METERS = {{hardLimitMax}};
  private static final double STARTING_HEIGHT_METERS = {{startingHeight}};
  private static final double STARTING_MOTOR_ROTATIONS = toMotorRotations(STARTING_HEIGHT_METERS);
{{#if enableSoftLimits}}
  // The motor controller will not drive the elevator past these heights.
  private static final double FORWARD_SOFT_LIMIT_MOTOR_ROTATIONS = toMotorRotations({{forwardSoftLimit}});
  private static final double REVERSE_SOFT_LIMIT_MOTOR_ROTATIONS = toMotorRotations({{reverseSoftLimit}});
{{/if}}

  // Feedforward gains, in volts per meter per second (kV) and per meter per second squared (kA).
  private final ElevatorFeedforward feedforward = new ElevatorFeedforward({{kS}}, {{kG}}, {{kV}}, {{kA}});
  // The fastest the closed loop moves the elevator, in meters per second and per second squared.
  private final TrapezoidProfile profile =
      new TrapezoidProfile(new TrapezoidProfile.Constraints({{maxVelocity}}, {{maxAcceleration}}));

{{> fields}}

  // Where the closed loop is now, and where it is going. A null goal means the closed loop is off.
  private TrapezoidProfile.State setpoint = new TrapezoidProfile.State(STARTING_HEIGHT_METERS, 0);
  private TrapezoidProfile.State goal = null;

  // The physics simulation of the elevator, and a drawing of it for a dashboard.
  private final ElevatorSim elevatorSim = new ElevatorSim(
      DC_MOTOR, GEAR_RATIO, CARRIAGE_MASS_KG, DRUM_RADIUS_METERS,
      MIN_HEIGHT_METERS, MAX_HEIGHT_METERS, true, STARTING_HEIGHT_METERS);
{{> simFields}}
  private final Mechanism2d mechanism2d = new Mechanism2d(1, MAX_HEIGHT_METERS + 0.5);
  private final MechanismLigament2d carriageLigament = mechanism2d
      .getRoot("Base", 0.5, 0)
      .append(new MechanismLigament2d("Elevator", STARTING_HEIGHT_METERS, 90));

  public {{className}}() {
{{> configure}}
    if (RobotBase.isSimulation()) {
{{> simInit}}
    }
  }

  private static double toMotorRotations(double meters) {
    return meters * MOTOR_ROTATIONS_PER_GAIN_UNIT;
  }

  private double getMotorRotations() {
{{> getMotorRotations}}
  }

  private double getMotorRPS() {
{{> getMotorRPS}}
  }

  /** The elevator's height. */
  public Distance getHeight() {
    return Meters.of(getMotorRotations() / MOTOR_ROTATIONS_PER_GAIN_UNIT);
  }

  /** How fast the elevator is moving. */
  public LinearVelocity getVelocity() {
    return MetersPerSecond.of(getMotorRPS() / MOTOR_ROTATIONS_PER_GAIN_UNIT);
  }

  /** The voltage the motor controller is applying to the motor. */
  public double getAppliedVolts() {
{{> getAppliedVolts}}
  }

  /** The motor's stator current, in amps. */
  public double getCurrent() {
{{> getCurrent}}
  }

  /** The motor's temperature, in degrees Celsius. */
  public double getTemperature() {
{{> getTemperature}}
  }

  private void setMotorPosition(double motorRotations, double feedforwardVolts) {
{{> setMotorPosition}}
  }

  private void setMotorVoltage(double volts) {
{{> setMotorVoltage}}
  }

  /** Start moving the elevator to a height with the closed loop. */
  private void setGoal(Distance height) {
    if (goal == null) {
      // Start the profile from where the elevator is now.
      setpoint = new TrapezoidProfile.State(getHeight().in(Meters), getVelocity().in(MetersPerSecond));
    }
    double meters = Math.max(MIN_HEIGHT_METERS, Math.min(MAX_HEIGHT_METERS, height.in(Meters)));
    goal = new TrapezoidProfile.State(meters, 0);
  }

  /** Go to a height and hold it. This command does not end on its own. */
  public Command setHeight(Distance height) {
    return run(coroutine -> {
      while (true) {
        setGoal(height);
        coroutine.yield();
      }
    }).named("{{className}} Set Height");
  }

  /** Drive the elevator with a duty cycle from -1 to 1. The closed loop is not used. */
  public Command set(double dutyCycle) {
    return run(coroutine -> {
      goal = null;
      while (true) {
        setMotorVoltage(dutyCycle * RobotController.getBatteryVoltage());
        coroutine.yield();
      }
    }).named("{{className}} Set Duty Cycle");
  }

  /** True while the elevator is within a tolerance of a height. */
  public Trigger near(Distance height, Distance tolerance) {
    return new Trigger(() -> getHeight().isNear(height, tolerance));
  }

  /** Call this from Robot.robotPeriodic(), before the scheduler runs. */
  public void periodic() {
    if (goal != null) {
      // Step the profile one loop, and give the motor controller the next setpoint and feedforward.
      TrapezoidProfile.State next = profile.calculate(0.020, setpoint, goal);
      double feedforwardVolts = feedforward.calculate(setpoint.velocity, next.velocity);
      setpoint = next;
      setMotorPosition(toMotorRotations(next.position), feedforwardVolts);
    }

{{#if logPosition}}
    Telemetry.log("{{ntKey}}/Height (m)", getHeight().in(Meters));
{{/if}}
{{#if logVelocity}}
    Telemetry.log("{{ntKey}}/Velocity (m per s)", getVelocity().in(MetersPerSecond));
{{/if}}
{{#if logVoltage}}
    Telemetry.log("{{ntKey}}/Applied Voltage", getAppliedVolts());
{{/if}}
{{#if logCurrent}}
    Telemetry.log("{{ntKey}}/Current", getCurrent());
{{/if}}
{{#if logTemperature}}
    Telemetry.log("{{ntKey}}/Temperature", getTemperature());
{{/if}}
    carriageLigament.setLength(getHeight().in(Meters));
    Telemetry.log("{{ntKey}}/Mechanism", mechanism2d);
  }

  /** Call this from Robot.simulationPeriodic(). */
  public void simulationPeriodic() {
    double batteryVolts = RobotController.getBatteryVoltage();
{{> simPrepare}}
    elevatorSim.setInputVoltage({{> simAppliedVolts}});
    elevatorSim.update(0.020);
    double motorRPS = elevatorSim.getVelocity() * MOTOR_ROTATIONS_PER_GAIN_UNIT;
{{> simUpdate}}
  }
}
