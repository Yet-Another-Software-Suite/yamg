/**
 * An elevator driven by a {{motorDisplayName}} through a {{controllerDisplayName}}. Generated by
 * YAMG.
 *
 * <p>Heights are measured by how far the drum has wound in the rope or belt.
 */
public class {{className}} implements Mechanism {
  private static final int CAN_ID = {{canId}};
  private static final DCMotor DC_MOTOR = {{{dcMotor}}};
  /** Motor rotations per drum rotation. */
  private static final double GEAR_RATIO = {{gearRatio}};
  /** The radius of the drum, or of the sprocket or pulley, that lifts the carriage. */
  private static final Distance DRUM_RADIUS = Meters.of({{drumRadius}});
  private static final boolean BRAKE_MODE = {{brakeMode}};
{{#if enableStatorLimit}}
  private static final Current STATOR_CURRENT_LIMIT = Amps.of({{statorCurrentLimit}});
{{/if}}
{{#if enableSupplyLimit}}
  private static final Current SUPPLY_CURRENT_LIMIT = Amps.of({{supplyCurrentLimit}});
{{/if}}
{{#if enableOpenLoopRamp}}
  private static final Time OPEN_LOOP_RAMP = Seconds.of({{openLoopRampRate}});
{{/if}}
{{#if enableClosedLoopRamp}}
  private static final Time CLOSED_LOOP_RAMP = Seconds.of({{closedLoopRampRate}});
{{/if}}
  /** How often the robot loop runs. */
  private static final Time LOOP_PERIOD = Seconds.of(0.020);

  // Closed loop gains, in volts per {{gainUnit}} of error.
  private static final double KP = {{kP}};
  private static final double KI = {{kI}};
  private static final double KD = {{kD}};
  /** Motor rotations per meter of travel, to convert heights and gains for the motor controller. */
  private static final double MOTOR_ROTATIONS_PER_GAIN_UNIT = GEAR_RATIO / (2 * Math.PI * DRUM_RADIUS.in(Meters));

  // The carriage, the elevator's physical limits, and where it is when the robot turns on.
  private static final Mass CARRIAGE_MASS = Kilograms.of({{mass}});
  private static final Distance MIN_HEIGHT = Meters.of({{hardLimitMin}});
  private static final Distance MAX_HEIGHT = Meters.of({{hardLimitMax}});
  private static final Distance STARTING_HEIGHT = Meters.of({{startingHeight}});
  private static final Angle STARTING_MOTOR_POSITION = toMotorPosition(STARTING_HEIGHT);
{{#if enableSoftLimits}}
  // The motor controller will not drive the elevator past these heights.
  private static final Angle FORWARD_SOFT_LIMIT = toMotorPosition(Meters.of({{forwardSoftLimit}}));
  private static final Angle REVERSE_SOFT_LIMIT = toMotorPosition(Meters.of({{reverseSoftLimit}}));
{{/if}}

  // The fastest the closed loop moves the elevator.
  private static final LinearVelocity MAX_VELOCITY = MetersPerSecond.of({{maxVelocity}});
  private static final LinearAcceleration MAX_ACCELERATION = MetersPerSecondPerSecond.of({{maxAcceleration}});
  private final TrapezoidProfile profile = new TrapezoidProfile(
      new TrapezoidProfile.Constraints(MAX_VELOCITY.in(MetersPerSecond), MAX_ACCELERATION.in(MetersPerSecondPerSecond)));

  // Feedforward gains, in volts per meter per second (kV) and per meter per second squared (kA).
  private final ElevatorFeedforward feedforward = new ElevatorFeedforward({{kS}}, {{kG}}, {{kV}}, {{kA}});

{{> fields}}

  // Where the closed loop is now, and where it is going, in meters. A null goal means the closed loop is off.
  private TrapezoidProfile.State setpoint = new TrapezoidProfile.State(STARTING_HEIGHT.in(Meters), 0);
  private TrapezoidProfile.State goal = null;

  // The physics simulation of the elevator, and a drawing of it for a dashboard.
  private final ElevatorSim elevatorSim = new ElevatorSim(
      DC_MOTOR, GEAR_RATIO, CARRIAGE_MASS.in(Kilograms), DRUM_RADIUS.in(Meters),
      MIN_HEIGHT.in(Meters), MAX_HEIGHT.in(Meters), true, STARTING_HEIGHT.in(Meters));
{{> simFields}}
  private final Mechanism2d mechanism2d = new Mechanism2d(1, MAX_HEIGHT.in(Meters) + 0.5);
  private final MechanismLigament2d carriageLigament = mechanism2d
      .getRoot("Base", 0.5, 0)
      .append(new MechanismLigament2d("Elevator", STARTING_HEIGHT.in(Meters), 90));

  public {{className}}() {
{{> configure}}
    if (RobotBase.isSimulation()) {
{{> simInit}}
    }
  }

  /** Where the motor's rotor is for a height. */
  private static Angle toMotorPosition(Distance height) {
    return Rotations.of(height.in(Meters) * MOTOR_ROTATIONS_PER_GAIN_UNIT);
  }

  private Angle getMotorPosition() {
{{> getMotorPosition}}
  }

  private AngularVelocity getMotorVelocity() {
{{> getMotorVelocity}}
  }

  /** The elevator's height. */
  public Distance getHeight() {
    return Meters.of(getMotorPosition().in(Rotations) / MOTOR_ROTATIONS_PER_GAIN_UNIT);
  }

  /** How fast the elevator is moving. */
  public LinearVelocity getVelocity() {
    return MetersPerSecond.of(getMotorVelocity().in(RotationsPerSecond) / MOTOR_ROTATIONS_PER_GAIN_UNIT);
  }

  /** The voltage the motor controller is applying to the motor. */
  public Voltage getVoltage() {
{{> getVoltage}}
  }

  /** The motor's stator current. */
  public Current getCurrent() {
{{> getCurrent}}
  }

  /** The motor's temperature. */
  public Temperature getTemperature() {
{{> getTemperature}}
  }

  private void setMotorPosition(Angle motorPosition, Voltage feedforward) {
{{> setMotorPosition}}
  }

  private void setMotorVoltage(Voltage voltage) {
{{> setMotorVoltage}}
  }

  /** Start moving the elevator to a height with the closed loop. */
  private void setGoal(Distance height) {
    if (goal == null) {
      // Start the profile from where the elevator is now.
      setpoint = new TrapezoidProfile.State(getHeight().in(Meters), getVelocity().in(MetersPerSecond));
    }
    Distance clamped = height.lt(MIN_HEIGHT) ? MIN_HEIGHT : height.gt(MAX_HEIGHT) ? MAX_HEIGHT : height;
    goal = new TrapezoidProfile.State(clamped.in(Meters), 0);
  }

  /** Go to a height and hold it. This command does not end on its own. */
  public Command setHeight(Distance height) {
    return run(coroutine -> {
      while (true) {
        setGoal(height);
        coroutine.yield();
      }
    }).named("{{className}} Set Height");
  }

  /** Drive the elevator with a duty cycle from -1 to 1. The closed loop is not used. */
  public Command set(double dutyCycle) {
    return run(coroutine -> {
      goal = null;
      while (true) {
        setMotorVoltage(RobotController.getMeasureBatteryVoltage().times(dutyCycle));
        coroutine.yield();
      }
    }).named("{{className}} Set Duty Cycle");
  }

  /** True while the elevator is within a tolerance of a height. */
  public Trigger near(Distance height, Distance tolerance) {
    return new Trigger(() -> getHeight().isNear(height, tolerance));
  }

  /** Call this from Robot.robotPeriodic(), before the scheduler runs. */
  public void periodic() {
    if (goal != null) {
      // Step the profile one loop, and give the motor controller the next setpoint and feedforward.
      TrapezoidProfile.State next = profile.calculate(LOOP_PERIOD.in(Seconds), setpoint, goal);
      Voltage feedforwardVoltage = Volts.of(feedforward.calculate(setpoint.velocity, next.velocity));
      setpoint = next;
      setMotorPosition(toMotorPosition(Meters.of(next.position)), feedforwardVoltage);
    }

{{#if logPosition}}
    Telemetry.log("{{ntKey}}/Height", getHeight());
{{/if}}
{{#if logVelocity}}
    Telemetry.log("{{ntKey}}/Velocity", getVelocity());
{{/if}}
{{#if logVoltage}}
    Telemetry.log("{{ntKey}}/Voltage", getVoltage());
{{/if}}
{{#if logCurrent}}
    Telemetry.log("{{ntKey}}/Current", getCurrent());
{{/if}}
{{#if logTemperature}}
    Telemetry.log("{{ntKey}}/Temperature", getTemperature());
{{/if}}
    carriageLigament.setLength(getHeight().in(Meters));
    Telemetry.log("{{ntKey}}/Mechanism", mechanism2d);
  }

  /** Call this from Robot.simulationPeriodic(). */
  public void simulationPeriodic() {
    Voltage batteryVoltage = RobotController.getMeasureBatteryVoltage();
{{> simPrepare}}
    elevatorSim.setInputVoltage({{> simAppliedVoltage}}.in(Volts));
    elevatorSim.update(LOOP_PERIOD.in(Seconds));
    AngularVelocity motorVelocity = RotationsPerSecond.of(elevatorSim.getVelocity() * MOTOR_ROTATIONS_PER_GAIN_UNIT);
{{> simUpdate}}
  }
}
