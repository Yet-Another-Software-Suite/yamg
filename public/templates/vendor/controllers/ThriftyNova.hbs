{{#*inline "imports"}}
import com.thrifty.core.Motor.MotorType;
import com.thrifty.nova.Nova;
import com.thrifty.nova.NovaConfig;
import org.wpilib.math.controller.PIDController;
{{/inline}}
{{#*inline "fields"}}
  // The Thrifty Nova on CAN bus 0.
  private final Nova motor = new Nova(0, CAN_ID, MotorType.{{thriftyMotorType}});
  // The closed loop runs here, on the SystemCore, in volts per {{gainUnit}}.
  private final PIDController pid = new PIDController(KP, KI, KD);
  // The last voltage given to the Nova, which the simulation uses.
  private Voltage appliedVoltage = Volts.of(0);
{{/inline}}
{{#*inline "configure"}}
    motor.configure(NovaConfig.brakeMode(BRAKE_MODE));
{{#if enableStatorLimit}}
    motor.configure(NovaConfig.statorCurrent(STATOR_CURRENT_LIMIT.in(Amps)));
{{/if}}
{{#if enableSupplyLimit}}
    motor.configure(NovaConfig.supplyCurrent(SUPPLY_CURRENT_LIMIT.in(Amps)));
{{/if}}
{{#if enableOpenLoopRamp}}
    motor.configure(NovaConfig.rampForward(OPEN_LOOP_RAMP.in(Seconds)), NovaConfig.rampReverse(OPEN_LOOP_RAMP.in(Seconds)));
{{/if}}
{{#if enableSoftLimits}}
    motor.configure(
        NovaConfig.softLimitForward(FORWARD_SOFT_LIMIT.times(GEAR_RATIO).in(Rotations)),
        NovaConfig.softLimitReverse(REVERSE_SOFT_LIMIT.times(GEAR_RATIO).in(Rotations)),
        NovaConfig.softLimitEnable(true));
{{/if}}
    motor.setIntPosition(STARTING_DRIVE_POSITION.times(GEAR_RATIO).in(Rotations));
{{/inline}}
{{#*inline "getDrivePosition"}}
    // The Nova counts motor rotations.
    return RobotBase.isSimulation() ? simDrivePosition : Rotations.of(motor.status().getIntPosition()).div(GEAR_RATIO);
{{/inline}}
{{#*inline "getDriveVelocity"}}
    return RobotBase.isSimulation() ? simDriveVelocity : RotationsPerSecond.of(motor.status().getIntVelocity()).div(GEAR_RATIO);
{{/inline}}
{{#*inline "getVoltage"}}
    return RobotBase.isSimulation() ? appliedVoltage : Volts.of(motor.status().getAppliedVoltage());
{{/inline}}
{{#*inline "getCurrent"}}
    return Amps.of(motor.status().getCurrentStator());
{{/inline}}
{{#*inline "getTemperature"}}
    return Celsius.of(motor.status().getTemperature());
{{/inline}}
{{#*inline "setDrivePosition"}}
    // The PID works in {{gainUnit}}s.
    Voltage pidVoltage = Volts.of(pid.calculate(
{{#if linear}}
        TRAVEL_PER_ROTATION.times(getDrivePosition().div(Rotations.one())).in(Meters),
        TRAVEL_PER_ROTATION.times(drivePosition.div(Rotations.one())).in(Meters)));
{{else}}
        getDrivePosition().in(Rotations), drivePosition.in(Rotations)));
{{/if}}
    setMotorVoltage(pidVoltage.plus(feedforward));
{{/inline}}
{{#*inline "setDriveVelocity"}}
    // The PID works in rotations per second.
    Voltage pidVoltage = Volts.of(pid.calculate(getDriveVelocity().in(RotationsPerSecond), driveVelocity.in(RotationsPerSecond)));
    setMotorVoltage(pidVoltage.plus(feedforward));
{{/inline}}
{{#*inline "setMotorVoltage"}}
    appliedVoltage = voltage;
    motor.setVoltage(voltage);
{{/inline}}
{{#*inline "simFields"}}
  // The simulated {{driveNoun}}.
  private Angle simDrivePosition = STARTING_DRIVE_POSITION;
  private AngularVelocity simDriveVelocity = RotationsPerSecond.of(0);
{{/inline}}
{{#*inline "simInit"}}{{/inline}}
{{#*inline "simPrepare"}}{{/inline}}
{{#*inline "simAppliedVoltage"}}(appliedVoltage.gt(batteryVoltage) ? batteryVoltage : appliedVoltage.lt(batteryVoltage.times(-1)) ? batteryVoltage.times(-1) : appliedVoltage){{/inline}}
{{#*inline "simUpdate"}}
    simDriveVelocity = driveVelocity;
    simDrivePosition = simDrivePosition.plus(driveVelocity.times(LOOP_PERIOD));
{{/inline}}
