{{#*inline "imports"}}
import com.ctre.phoenix6.CANBus;
import com.ctre.phoenix6.configs.TalonFXSConfiguration;
{{#if useProfile}}
import com.ctre.phoenix6.controls.MotionMagicVoltage;
{{else if (not velocityControl)}}
import com.ctre.phoenix6.controls.PositionVoltage;
{{/if}}
import com.ctre.phoenix6.controls.VelocityVoltage;
import com.ctre.phoenix6.controls.VoltageOut;
import com.ctre.phoenix6.hardware.TalonFXS;
import com.ctre.phoenix6.signals.MotorArrangementValue;
import com.ctre.phoenix6.signals.GravityTypeValue;
import com.ctre.phoenix6.signals.NeutralModeValue;
import org.wpilib.hardware.bus.CANPort;
{{#if useProfile}}
import static org.wpilib.units.Units.RotationsPerSecondPerSecond;
{{/if}}
{{/inline}}
{{#*inline "fields"}}
  // The Talon FXS, and the requests that control it.
  private final TalonFXS motor = new TalonFXS(CAN_ID, new CANBus(CANPort.{{canPort}}));
{{#if velocityControl}}
  private final VelocityVoltage velocityRequest = new VelocityVoltage(0);
{{else if useProfile}}
  // Motion Magic runs a trapezoidal profile to the goal.
  private final MotionMagicVoltage profileRequest = new MotionMagicVoltage(0);
{{else}}
  // PositionVoltage: the Talon's closed loop goes straight to the goal.
  private final PositionVoltage positionRequest = new PositionVoltage(0);
{{/if}}
  private final VoltageOut voltageRequest = new VoltageOut(0);
{{/inline}}
{{#*inline "configure"}}
    TalonFXSConfiguration config = new TalonFXSConfiguration();
    // The motor the Talon FXS drives.
    config.Commutation.withMotorArrangement(MotorArrangementValue.{{talonFXSArrangement}});
    // Phoenix applies the gearing, so positions, speeds, soft limits and gains are all in turns of
    // the mechanism, and its closed loop outputs volts.
    config.ExternalFeedback.withSensorToMechanismRatio(GEAR_RATIO);
{{#if linear}}
    // Phoenix has no linear units, so the gains go from per meter to per turn.
    double metersPerRotation = TRAVEL_PER_ROTATION.in(Meters);
    config.Slot0.withKP(KP * metersPerRotation).withKI(KI * metersPerRotation).withKD(KD * metersPerRotation);
{{else}}
    config.Slot0.withKP(KP).withKI(KI).withKD(KD);
{{/if}}
    // The Talon runs the feedforward itself, with its gains per turn of the mechanism.
{{#if (eq mechanismType "Arm")}}
    // Arm_Cosine scales kG by the cosine of the arm's angle, which is 0 when the arm points straight out.
    // kV and kA are per turn already.
    config.Slot0.withGravityType(GravityTypeValue.Arm_Cosine).withKG({{kG}});
    config.Slot0.withKS({{kS}}).withKV({{kV}}).withKA({{kA}});
{{/if}}
{{#if (eq mechanismType "Elevator")}}
    // Elevator_Static applies kG all the time. kV and kA are per meter, so they go to per turn.
    config.Slot0.withGravityType(GravityTypeValue.Elevator_Static).withKG({{kG}});
    config.Slot0.withKS({{kS}}).withKV({{kV}} * metersPerRotation).withKA({{kA}} * metersPerRotation);
{{/if}}
{{#if (eq mechanismType "Pivot")}}
    config.Slot0.withKS({{kS}}).withKV({{kV}}).withKA({{kA}});
{{/if}}
{{#if (eq mechanismType "Flywheel")}}
    config.Slot0.withKS({{kS}}).withKV({{kV}}).withKA({{kA}});
{{/if}}
{{#if useProfile}}
    // Motion Magic: the fastest the profile moves and accelerates the mechanism.
{{#if linear}}
    config.MotionMagic
        .withMotionMagicCruiseVelocity(RotationsPerSecond.of(MAX_VELOCITY.div(TRAVEL_PER_ROTATION).in(MetersPerSecond.per(Meter))))
        .withMotionMagicAcceleration(RotationsPerSecondPerSecond.of(MAX_ACCELERATION.div(TRAVEL_PER_ROTATION).in(MetersPerSecondPerSecond.per(Meter))));
{{else}}
    config.MotionMagic.withMotionMagicCruiseVelocity(MAX_VELOCITY).withMotionMagicAcceleration(MAX_ACCELERATION);
{{/if}}
{{/if}}
    config.MotorOutput.withNeutralMode(BRAKE_MODE ? NeutralModeValue.Brake : NeutralModeValue.Coast);
{{#if enableStatorLimit}}
    config.CurrentLimits.withStatorCurrentLimit(STATOR_CURRENT_LIMIT).withStatorCurrentLimitEnable(true);
{{/if}}
{{#if enableSupplyLimit}}
    config.CurrentLimits.withSupplyCurrentLimit(SUPPLY_CURRENT_LIMIT).withSupplyCurrentLimitEnable(true);
{{/if}}
{{#if enableOpenLoopRamp}}
    config.OpenLoopRamps.withVoltageOpenLoopRampPeriod(OPEN_LOOP_RAMP);
{{/if}}
{{#if enableClosedLoopRamp}}
    config.ClosedLoopRamps.withVoltageClosedLoopRampPeriod(CLOSED_LOOP_RAMP);
{{/if}}
{{#if enableSoftLimits}}
    config.SoftwareLimitSwitch
        .withForwardSoftLimitThreshold(FORWARD_SOFT_LIMIT)
        .withForwardSoftLimitEnable(true)
        .withReverseSoftLimitThreshold(REVERSE_SOFT_LIMIT)
        .withReverseSoftLimitEnable(true);
{{/if}}
    motor.getConfigurator().apply(config);
    if (RobotBase.isSimulation()) {
      // Start the simulated rotor where the mechanism starts, so that the Talon's position does
      // not count the starting position twice.
      motor.getSimState().setRawRotorPosition(STARTING_MECHANISM_POSITION.times(GEAR_RATIO));
    }
    motor.setPosition(STARTING_MECHANISM_POSITION);
{{/inline}}
{{#*inline "getMechanismPosition"}}
    return motor.getPosition().getValue();
{{/inline}}
{{#*inline "getMechanismVelocity"}}
    return motor.getVelocity().getValue();
{{/inline}}
{{#*inline "getVoltage"}}
    return motor.getMotorVoltage().getValue();
{{/inline}}
{{#*inline "getCurrent"}}
    return motor.getStatorCurrent().getValue();
{{/inline}}
{{#*inline "getTemperature"}}
    return motor.getDeviceTemp().getValue();
{{/inline}}
{{#*inline "setMechanismGoal"}}
    motor.setControl({{#if useProfile}}profileRequest{{else}}positionRequest{{/if}}.withPosition(goal));
{{/inline}}
{{#*inline "setMechanismGoalVelocity"}}
    motor.setControl(velocityRequest.withVelocity(goal));
{{/inline}}
{{#*inline "setMotorVoltage"}}
    motor.setControl(voltageRequest.withOutput(voltage));
{{/inline}}
{{#*inline "simFields"}}{{/inline}}
{{#*inline "simInit"}}{{/inline}}
{{#*inline "simPrepare"}}
    motor.getSimState().setSupplyVoltage(batteryVoltage);
{{/inline}}
{{#*inline "simAppliedVoltage"}}motor.getSimState().getMotorVoltageMeasure(){{/inline}}
{{#*inline "simUpdate"}}
    // Give the Talon the simulated rotor, which is the motor's, before the gearing.
    motor.getSimState().setRawRotorPosition(mechanismPosition.times(GEAR_RATIO));
    motor.getSimState().setRotorVelocity(mechanismVelocity.times(GEAR_RATIO));
    motor.getSimState().setRotorAcceleration(mechanismAcceleration.times(GEAR_RATIO));
{{/inline}}
{{#*inline "setEncoderPosition"}}
    motor.setPosition(mechanismPosition);
{{/inline}}
