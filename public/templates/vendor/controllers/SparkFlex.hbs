{{#*inline "imports"}}
import com.revrobotics.PersistMode;
import com.revrobotics.RelativeEncoder;
import com.revrobotics.ResetMode;
import com.revrobotics.spark.ClosedLoopSlot;
import com.revrobotics.spark.FeedbackSensor;
import com.revrobotics.spark.SparkClosedLoopController;
import com.revrobotics.spark.SparkClosedLoopController.ArbFFUnits;
import com.revrobotics.spark.SparkLowLevel.ControlType;
import com.revrobotics.spark.SparkLowLevel.MotorType;
import com.revrobotics.spark.SparkFlex;
import com.revrobotics.spark.SparkSim;
import com.revrobotics.spark.config.MAXMotionConfig.MAXMotionPositionMode;
import com.revrobotics.spark.config.SparkBaseConfig.IdleMode;
import com.revrobotics.spark.config.SparkFlexConfig;
import org.wpilib.hardware.bus.CANPort;
import static org.wpilib.units.Units.RotationsPerSecondPerSecond;
import static org.wpilib.units.Units.Second;
import static org.wpilib.units.Units.Milliseconds;
{{/inline}}
{{#*inline "fields"}}
  // The SPARK Flex, its built-in encoder and its closed loop controller.
  private final SparkFlex motor = new SparkFlex(CANPort.{{canPort}}, CAN_ID, MotorType.kBrushless);
  private final RelativeEncoder encoder = motor.getEncoder();
  private final SparkClosedLoopController closedLoop = motor.getClosedLoopController();
{{/inline}}
{{#*inline "configure"}}
    // REVLib 2027 has no conversion factors. The SPARK works in motor rotations and RPM, and its
    // closed loop outputs a duty cycle, so the gains are converted from volts per {{gainUnit}} here.
    double gainScale = 12.0 * GEAR_RATIO{{#if velocityControl}} * 60.0{{/if}}{{#if linear}} / TRAVEL_PER_ROTATION.in(Meters){{/if}};
    // A SPARK runs its closed loop every millisecond, and its kI and kD are per loop.
    // REVLib's simulated SPARK applies them per second instead.
    Time sparkLoopPeriod = RobotBase.isSimulation() ? Seconds.of(1) : Milliseconds.of(1);

    SparkFlexConfig config = new SparkFlexConfig();
    config.idleMode(BRAKE_MODE ? IdleMode.kBrake : IdleMode.kCoast);
    // Scale the duty cycle to a 12 volt battery, so that the gains act the same as the battery drains.
    config.voltageCompensation(12.0);
{{#if enableStatorLimit}}
    config.smartCurrentLimit((int) STATOR_CURRENT_LIMIT.in(Amps));
{{/if}}
{{#if enableOpenLoopRamp}}
    config.openLoopRampRate(OPEN_LOOP_RAMP.in(Seconds));
{{/if}}
{{#if enableClosedLoopRamp}}
    config.closedLoopRampRate(CLOSED_LOOP_RAMP.in(Seconds));
{{/if}}
    config.closedLoop
        .feedbackSensor(FeedbackSensor.kPrimaryEncoder)
        .pid(KP / gainScale, KI * sparkLoopPeriod.in(Seconds) / gainScale, KD / sparkLoopPeriod.in(Seconds) / gainScale);
    // The SPARK runs the feedforward itself. Its kS and kG are in volts, and its kV and kA per
    // motor RPM, so they are converted from per {{gainUnit}}.
    double rpmPerGainUnit = {{#if (eq mechanismType "Arm")}}RadiansPerSecond{{else}}RotationsPerSecond{{/if}}.of(GEAR_RATIO).in(RPM){{#if linear}} / TRAVEL_PER_ROTATION.in(Meters){{/if}};
    config.closedLoop.feedForward.kS({{kS}}).kV({{kV}} / rpmPerGainUnit).kA({{kA}} / rpmPerGainUnit);
{{#if (eq mechanismType "Arm")}}
    if (!RobotBase.isSimulation()) {
      // kCos scales kG by the cosine of the arm's angle, which is 0 when the arm points straight out.
      // kCosRatio turns the encoder's motor rotations into arm rotations. In simulation the
      // SystemCore adds gravity instead: REVLib's simulated SPARK works kCos out from the setpoint
      // in degrees, not from the arm's angle.
      config.closedLoop.feedForward.kCos({{kG}}).kCosRatio(1.0 / GEAR_RATIO);
    }
{{/if}}
{{#if (eq mechanismType "Elevator")}}
    config.closedLoop.feedForward.kG({{kG}});
{{/if}}
{{#if useProfile}}
    // MAXMotion runs a trapezoidal profile to the goal, in motor RPM and RPM per second.
    config.closedLoop.maxMotion
        .positionMode(MAXMotionPositionMode.kMAXMotionTrapezoidal)
{{#if linear}}
        .cruiseVelocity(RotationsPerSecond.of(MAX_VELOCITY.div(TRAVEL_PER_ROTATION).in(MetersPerSecond.per(Meter))).times(GEAR_RATIO).in(RPM))
        .maxAcceleration(RotationsPerSecondPerSecond.of(MAX_ACCELERATION.div(TRAVEL_PER_ROTATION).in(MetersPerSecondPerSecond.per(Meter))).times(GEAR_RATIO).in(RPM.per(Second)));
{{else}}
        .cruiseVelocity(MAX_VELOCITY.times(GEAR_RATIO).in(RPM))
        .maxAcceleration(MAX_ACCELERATION.times(GEAR_RATIO).in(RPM.per(Second)));
{{/if}}
{{/if}}
{{#if enableSoftLimits}}
    config.softLimit
        .forwardSoftLimit(FORWARD_SOFT_LIMIT.times(GEAR_RATIO).in(Rotations))
        .forwardSoftLimitEnabled(true)
        .reverseSoftLimit(REVERSE_SOFT_LIMIT.times(GEAR_RATIO).in(Rotations))
        .reverseSoftLimitEnabled(true);
{{/if}}
    motor.configure(config, ResetMode.kResetSafeParameters, PersistMode.kPersistParameters);
    encoder.setPosition(STARTING_MECHANISM_POSITION.times(GEAR_RATIO).in(Rotations));
{{/inline}}
{{#*inline "getMechanismPosition"}}
    // The encoder counts motor rotations.
    return Rotations.of(encoder.getPosition().get()).div(GEAR_RATIO);
{{/inline}}
{{#*inline "getMechanismVelocity"}}
    return RPM.of(encoder.getVelocity().get()).div(GEAR_RATIO);
{{/inline}}
{{#*inline "getVoltage"}}
    return Volts.of(motor.getAppliedOutput().get() * motor.getBusVoltage().get());
{{/inline}}
{{#*inline "getCurrent"}}
    return Amps.of(motor.getOutputCurrent().get());
{{/inline}}
{{#*inline "getTemperature"}}
    return Celsius.of(motor.getMotorTemperature().get());
{{/inline}}
{{#*inline "setMechanismGoal"}}
    closedLoop.setSetpoint(goal.times(GEAR_RATIO).in(Rotations), ControlType.{{#if useProfile}}kMAXMotionPositionControl{{else}}kPosition{{/if}}, ClosedLoopSlot.kSlot0);
{{/inline}}
{{#*inline "setMechanismGoalVelocity"}}
    closedLoop.setSetpoint(goal.times(GEAR_RATIO).in(RPM), ControlType.kVelocity, ClosedLoopSlot.kSlot0);
{{/inline}}
{{#*inline "setMechanismPosition"}}
    closedLoop.setSetpoint(mechanismPosition.times(GEAR_RATIO).in(Rotations), ControlType.kPosition, ClosedLoopSlot.kSlot0, feedforward.in(Volts), ArbFFUnits.kVoltage);
{{/inline}}
{{#*inline "setMechanismVelocity"}}
    closedLoop.setSetpoint(mechanismVelocity.times(GEAR_RATIO).in(RPM), ControlType.kVelocity, ClosedLoopSlot.kSlot0, feedforward.in(Volts), ArbFFUnits.kVoltage);
{{/inline}}
{{#*inline "setMotorVoltage"}}
    motor.setVoltage(voltage);
{{/inline}}
{{#*inline "simFields"}}
  // REVLib's simulated SPARK. It runs the closed loop in simulation.
  private SparkSim motorSim;
{{/inline}}
{{#*inline "simInit"}}
      motorSim = new SparkSim(motor, DC_MOTOR);
{{/inline}}
{{#*inline "simPrepare"}}{{/inline}}
{{#*inline "simAppliedVoltage"}}batteryVoltage.times(motorSim.getAppliedOutput()){{/inline}}
{{#*inline "simUpdate"}}
    // Give the SPARK the motor's simulated speed, so that it updates its encoder.
    motorSim.iterate(mechanismVelocity.times(GEAR_RATIO).in(RPM), batteryVoltage.in(Volts), LOOP_PERIOD.in(Seconds));
{{/inline}}
{{#*inline "setEncoderPosition"}}
    encoder.setPosition(mechanismPosition.times(GEAR_RATIO).in(Rotations));
{{/inline}}
