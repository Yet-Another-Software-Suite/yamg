{{#*inline "imports"}}
import com.revrobotics.PersistMode;
import com.revrobotics.RelativeEncoder;
import com.revrobotics.ResetMode;
import com.revrobotics.spark.ClosedLoopSlot;
import com.revrobotics.spark.FeedbackSensor;
import com.revrobotics.spark.SparkClosedLoopController;
import com.revrobotics.spark.SparkClosedLoopController.ArbFFUnits;
import com.revrobotics.spark.SparkLowLevel.ControlType;
import com.revrobotics.spark.SparkLowLevel.MotorType;
import com.revrobotics.spark.SparkMax;
import com.revrobotics.spark.SparkSim;
import com.revrobotics.spark.config.SparkBaseConfig.IdleMode;
import com.revrobotics.spark.config.SparkMaxConfig;
import org.wpilib.hardware.bus.CANPort;
import static org.wpilib.units.Units.Milliseconds;
{{/inline}}
{{#*inline "fields"}}
  // The SPARK MAX, its built-in encoder and its closed loop controller.
  private final SparkMax motor = new SparkMax(CANPort.CAN_S0, CAN_ID, MotorType.kBrushless);
  private final RelativeEncoder encoder = motor.getEncoder();
  private final SparkClosedLoopController closedLoop = motor.getClosedLoopController();
{{/inline}}
{{#*inline "configure"}}
    // REVLib 2027 has no conversion factors. The SPARK works in motor rotations and RPM, and its
    // closed loop outputs a duty cycle, so the gains are converted from volts per {{gainUnit}} here.
    double gainScale = 12.0 * GEAR_RATIO{{#if velocityControl}} * 60.0{{/if}}{{#if linear}} / TRAVEL_PER_ROTATION.in(Meters){{/if}};
    // A SPARK runs its closed loop every millisecond, and its kI and kD are per loop.
    // REVLib's simulated SPARK applies them per second instead.
    Time sparkLoopPeriod = RobotBase.isSimulation() ? Seconds.of(1) : Milliseconds.of(1);

    SparkMaxConfig config = new SparkMaxConfig();
    config.idleMode(BRAKE_MODE ? IdleMode.kBrake : IdleMode.kCoast);
    // Scale the duty cycle to a 12 volt battery, so that the gains act the same as the battery drains.
    config.voltageCompensation(12.0);
{{#if enableStatorLimit}}
    config.smartCurrentLimit((int) STATOR_CURRENT_LIMIT.in(Amps));
{{/if}}
{{#if enableOpenLoopRamp}}
    config.openLoopRampRate(OPEN_LOOP_RAMP.in(Seconds));
{{/if}}
{{#if enableClosedLoopRamp}}
    config.closedLoopRampRate(CLOSED_LOOP_RAMP.in(Seconds));
{{/if}}
    config.closedLoop
        .feedbackSensor(FeedbackSensor.kPrimaryEncoder)
        .pid(KP / gainScale, KI * sparkLoopPeriod.in(Seconds) / gainScale, KD / sparkLoopPeriod.in(Seconds) / gainScale);
{{#if enableSoftLimits}}
    config.softLimit
        .forwardSoftLimit(FORWARD_SOFT_LIMIT.times(GEAR_RATIO).in(Rotations))
        .forwardSoftLimitEnabled(true)
        .reverseSoftLimit(REVERSE_SOFT_LIMIT.times(GEAR_RATIO).in(Rotations))
        .reverseSoftLimitEnabled(true);
{{/if}}
    motor.configure(config, ResetMode.kResetSafeParameters, PersistMode.kPersistParameters);
    encoder.setPosition(STARTING_DRIVE_POSITION.times(GEAR_RATIO).in(Rotations));
{{/inline}}
{{#*inline "getDrivePosition"}}
    // The encoder counts motor rotations.
    return Rotations.of(encoder.getPosition().get()).div(GEAR_RATIO);
{{/inline}}
{{#*inline "getDriveVelocity"}}
    return RPM.of(encoder.getVelocity().get()).div(GEAR_RATIO);
{{/inline}}
{{#*inline "getVoltage"}}
    return Volts.of(motor.getAppliedOutput().get() * motor.getBusVoltage().get());
{{/inline}}
{{#*inline "getCurrent"}}
    return Amps.of(motor.getOutputCurrent().get());
{{/inline}}
{{#*inline "getTemperature"}}
    return Celsius.of(motor.getMotorTemperature().get());
{{/inline}}
{{#*inline "setDrivePosition"}}
    closedLoop.setSetpoint(drivePosition.times(GEAR_RATIO).in(Rotations), ControlType.kPosition, ClosedLoopSlot.kSlot0, feedforward.in(Volts), ArbFFUnits.kVoltage);
{{/inline}}
{{#*inline "setDriveVelocity"}}
    closedLoop.setSetpoint(driveVelocity.times(GEAR_RATIO).in(RPM), ControlType.kVelocity, ClosedLoopSlot.kSlot0, feedforward.in(Volts), ArbFFUnits.kVoltage);
{{/inline}}
{{#*inline "setMotorVoltage"}}
    motor.setVoltage(voltage);
{{/inline}}
{{#*inline "simFields"}}
  // REVLib's simulated SPARK. It runs the closed loop in simulation.
  private SparkSim motorSim;
{{/inline}}
{{#*inline "simInit"}}
      motorSim = new SparkSim(motor, DC_MOTOR);
{{/inline}}
{{#*inline "simPrepare"}}{{/inline}}
{{#*inline "simAppliedVoltage"}}batteryVoltage.times(motorSim.getAppliedOutput()){{/inline}}
{{#*inline "simUpdate"}}
    // Give the SPARK the motor's simulated speed, so that it updates its encoder.
    motorSim.iterate(driveVelocity.times(GEAR_RATIO).in(RPM), batteryVoltage.in(Volts), LOOP_PERIOD.in(Seconds));
{{/inline}}
