package frc.robot.subsystems;

import edu.wpi.first.epilogue.Logged;
import edu.wpi.first.wpilibj2.command.SubsystemBase;
import edu.wpi.first.wpilibj.simulation.FlywheelSim;
import edu.wpi.first.math.controller.SimpleMotorFeedforward;
import edu.wpi.first.math.system.plant.DCMotor;
import edu.wpi.first.wpilibj.RobotController;
import edu.wpi.first.wpilibj2.command.Command;
import edu.wpi.first.wpilibj.simulation.BatterySim;
import edu.wpi.first.wpilibj.simulation.RoboRioSim;
import static edu.wpi.first.units.Units.RadiansPerSecond;
import static edu.wpi.first.units.Units.RotationsPerSecond;
{{#if wpilibControlled}}
import edu.wpi.first.math.controller.PIDController;
import edu.wpi.first.wpilibj.Notifier;
{{/if}}

{{{motorControllerImports}}}

/**
* Flywheel subsystem using {{motorControllerType}} with {{motorType}} motor
*/
@Logged(name = "{{ntKey}}")
public class {{subsystemName}} extends SubsystemBase {
  // Constants
  private final DCMotor dcMotor = {{{dcMotorType}}};
  private final int canID = {{canId}};
  private final double gearRatio = {{gearRatio}};
  private final double kP = {{pidValues.kP}};
  private final double kI = {{pidValues.kI}};
  private final double kD = {{pidValues.kD}};
  private final double kS = {{kS}};
  private final double kV = {{kV}};
  private final double kA = {{kA}};
  private final double kG = 0; // Unused for flywheels
  private final double maxVelocity = {{maxVelocity}}; // rad/s
  private final double maxAcceleration = {{maxAcceleration}}; // rad/s²
  private final boolean brakeMode = {{brakeMode}};
  private final boolean enableStatorLimit = {{enableStatorLimit}};
  private final double statorCurrentLimit = {{statorCurrentLimit}};
  private final boolean enableSupplyLimit = {{enableSupplyLimit}};
  private final double supplyCurrentLimit = {{supplyCurrentLimit}};
  private final double momentOfInertia = {{momentOfInertia}}; // kg*m^2, flywheel moment of inertia

  // Feedforward
  private final SimpleMotorFeedforward feedforward = new SimpleMotorFeedforward(kS, kV, kA);

  // Motor controller
  {{{motorControllerDeclaration}}}

  {{#if wpilibControlled}}
  // Control mode
  private enum ControlMode {
    OPEN_LOOP,
    VELOCITY
  }
  private ControlMode currentControlMode = ControlMode.OPEN_LOOP;
  private double targetVelocity = 0.0;

  // Velocity PID Controller
  private PIDController velocityController;
  private Notifier controlLoop;
  private final double CONTROL_LOOP_FREQUENCY = 100.0; // Hz
  {{/if}}

  // Simulation
  private final FlywheelSim flywheelSim;

  /**
   * Creates a new Flywheel Subsystem.
   */
  public {{subsystemName}}() {
    // Initialize motor controller
    {{{motorControllerInitialization}}}

    // Initialize simulation
    flywheelSim = new FlywheelSim(
      dcMotor, // Motor type
      gearRatio,
      momentOfInertia // Flywheel moment of inertia (kg*m^2)
    );

    {{#if wpilibControlled}}
    // Initialize velocity PID controller
    velocityController = new PIDController(kP, kI, kD);

    // Start control loop on a separate thread using Notifier
    controlLoop = new Notifier(this::controlLoopFn);
    controlLoop.startPeriodic(1.0 / CONTROL_LOOP_FREQUENCY);
    {{/if}}
  }

  {{#if wpilibControlled}}
  /**
   * Control loop function that runs at a fixed frequency.
   * This is used for ThriftyNova to implement closed-loop control
   * outside of the main robot loop.
   */
  private void controlLoopFn() {
    switch (currentControlMode) {
      case VELOCITY:
        double currentVel = getVelocity();
        double velOutput = velocityController.calculate(currentVel, targetVelocity);
        double velFeedforwardOutput = feedforward.calculate(targetVelocity);
        setVoltage(velOutput + velFeedforwardOutput);
        break;

      case OPEN_LOOP:
      default:
        // Do nothing, voltage is set directly
        break;
    }
  }

  /**
   * Clean up resources when the subsystem is destroyed.
   */
  public void close() {
    motor.close();
  }
  {{/if}}

  /**
   * Update simulation and telemetry.
   */
  @Override
  public void periodic() {
    {{{motorControllerPeriodic}}}
    {{#if wpilibControlled}}
    controlLoopFn();
    {{/if}}
  }

  /**
   * Update simulation.
   */
  @Override
  public void simulationPeriodic() {
    {{#if (or (eq motorControllerType 'TalonFX') (eq motorControllerType 'TalonFXS'))}}
    // Use motor voltage for TalonFX simulation input
    flywheelSim.setInput(motor.getSimState().getMotorVoltage());
    {{else}}
    // Use getVoltage() for other controllers
    flywheelSim.setInput(getVoltage());
    {{/if}}

    // Update simulation by 20ms
    flywheelSim.update(0.020);
    RoboRioSim.setVInVoltage(BatterySim.calculateDefaultBatteryLoadedVoltage(flywheelSim.getCurrentDrawAmps()));

    double motorVelocity = RadiansPerSecond.of(flywheelSim.getAngularVelocityRadPerSec() * gearRatio).in(RotationsPerSecond);
    double motorPosition = 0; // Flywheels do not track absolute position
    {{{motorControllerSimulationPeriodic}}}
  }

  /**
   * Get the current velocity in rotations per second.
   * @return Velocity in rotations per second
   */
  {{#if logVelocity}}
  @Logged(name = "Velocity")
  {{/if}}
  public double getVelocity() {
    {{{getVelocityMethod}}}
  }

  /**
   * Get the current velocity in RPM.
   * @return Velocity in RPM
   */
  {{#if logVelocity}}
  @Logged(name = "Velocity/RPM")
  {{/if}}
  public double getVelocityRPM() {
    return getVelocity() * 60.0;
  }

  /**
   * Get the current applied voltage.
   * @return Applied voltage
   */
  {{#if logVoltage}}
  @Logged(name = "Voltage")
  {{/if}}
  public double getVoltage() {
    {{{getVoltageMethod}}}
  }

  /**
   * Get the current motor current.
   * @return Motor current in amps
   */
  {{#if logCurrent}}
  @Logged(name = "Current")
  {{/if}}
  public double getCurrent() {
    {{{getCurrentMethod}}}
  }

  /**
   * Get the current motor temperature.
   * @return Motor temperature in Celsius
   */
  {{#if logTemperature}}
  @Logged(name = "Temperature")
  {{/if}}
  public double getTemperature() {
    {{{getTemperatureMethod}}}
  }

  /**
   * Set flywheel velocity.
   * @param velocityRPM The target velocity in RPM
   */
  public void setVelocity(double velocityRPM) {
    // Convert RPM to rotations per second
    double velocityRotations = velocityRPM / 60.0;

    {{#if wpilibControlled}}
    // Use the velocity PID controller
    targetVelocity = velocityRotations;
    currentControlMode = ControlMode.VELOCITY;

    // Apply feedforward directly to the motor controller as well
    // This ensures immediate response while the control loop refines it
    double ffVolts = feedforward.calculate(velocityRotations);
    motor.setVoltage(ffVolts);
    {{else}}
    double acceleration = 0;
    {{{setVelocityMethod}}}
    {{/if}}
  }

  /**
   * Set motor voltage directly.
   * @param voltage The voltage to apply
   */
  public void setVoltage(double voltage) {
    {{#if wpilibControlled}}
    currentControlMode = ControlMode.OPEN_LOOP;
    {{/if}}
    {{{setVoltageMethod}}}
  }

  /**
   * Get the flywheel simulation for testing.
   * @return The flywheel simulation model
   */
  public FlywheelSim getSimulation() {
    return flywheelSim;
  }

  /**
   * Checks whether the flywheel is within tolerance of a target velocity.
   * @param velocityRPM The target velocity in RPM
   * @return True if within 2% (or 50 RPM, whichever is greater) of the target velocity
   */
  public boolean atTargetVelocity(double velocityRPM) {
    return Math.abs(getVelocityRPM() - velocityRPM) < Math.max(50.0, Math.abs(velocityRPM) * 0.02);
  }

  /**
   * Creates a command to spin the flywheel up to a specific velocity.
   * @param velocityRPM The target velocity in RPM
   * @return A command that spins the flywheel to the specified velocity
   */
  public Command spinUpCommand(double velocityRPM) {
    return run(() -> setVelocity(velocityRPM)).until(() -> atTargetVelocity(velocityRPM));
  }

  /**
   * Creates a command to stop the flywheel.
   * @return A command that stops the flywheel
   */
  public Command stopCommand() {
    return runOnce(() -> setVelocity(0));
  }
}
