package frc.robot.subsystems;

import edu.wpi.first.wpilibj2.command.SubsystemBase;
import edu.wpi.first.wpilibj.smartdashboard.Mechanism2d;
import edu.wpi.first.wpilibj.smartdashboard.MechanismLigament2d;
import edu.wpi.first.wpilibj.smartdashboard.MechanismRoot2d;
import edu.wpi.first.wpilibj.smartdashboard.SmartDashboard;
import edu.wpi.first.wpilibj.util.Color8Bit;
import edu.wpi.first.wpilibj.util.Color;
import edu.wpi.first.math.util.Units;

/**
* Visualization for the flywheel subsystem in simulation.
*/
public class {{subsystemName}}Sim extends SubsystemBase {
private final {{subsystemName}} flywheel;

// Simulation display
private final Mechanism2d mech;
private final MechanismRoot2d root;
private final MechanismLigament2d spinner;

// Visualization constants
private final double WHEEL_RADIUS = 50.0;
private final double SPINNER_WIDTH = 6.0;

// Accumulated visual angle (degrees), used to animate the spin
private double displayAngleDegrees = 0.0;

/**
 * Creates a new visualization for the flywheel.
 *
 * @param flywheelSubsystem The flywheel subsystem to visualize
 */
public {{subsystemName}}Sim({{subsystemName}} flywheelSubsystem) {
  this.flywheel = flywheelSubsystem;

  // Create the simulation display
  mech = new Mechanism2d(200, 200);
  root = mech.getRoot("FlywheelRoot", 100, 100);

  // Add a spinner ligament to visualize rotation
  spinner = root.append(
      new MechanismLigament2d("Spinner", WHEEL_RADIUS, 0, SPINNER_WIDTH, new Color8Bit(Color.kBlue)));

  // Initialize visualization
  SmartDashboard.putData("Flywheel Sim", mech);
}

@Override
public void periodic() {
  // Advance the visual angle based on current velocity (rad/s -> deg over 20ms)
  double velocityRadPerSec = flywheel.getSimulation().getAngularVelocityRadPerSec();
  displayAngleDegrees = (displayAngleDegrees + Units.radiansToDegrees(velocityRadPerSec) * 0.02) % 360.0;
  spinner.setAngle(displayAngleDegrees);

  // Add telemetry data
  SmartDashboard.putNumber("Flywheel Velocity (RPM)", flywheel.getVelocityRPM());
  SmartDashboard.putNumber("Flywheel Current (A)", flywheel.getSimulation().getCurrentDrawAmps());
}
}
