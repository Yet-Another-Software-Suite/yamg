import com.ctre.phoenix6.hardware.TalonFXS;
import org.wpilib.hardware.bus.CANPort;
import yams.core.motorcontrollers.remote.TalonFXSWrapper;
{{/inline}}
{{#*inline "device"}}
  // The vendor motor controller object: a Talon FXS with CAN ID {{canId}}.
  private final TalonFXS talon = new TalonFXS({{canId}}, new CANBus(CANPort.CAN_S0));
{{/inline}}
{{#*inline "fields"}}
  // The SmartMotorController applies the config to the Talon FXS, which drives one {{motorDisplayName}}.
