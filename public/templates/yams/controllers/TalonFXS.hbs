{{#*inline "imports"}}
import com.ctre.phoenix6.CANBus;
import com.ctre.phoenix6.hardware.TalonFXS;
import org.wpilib.hardware.bus.CANPort;
import yams.core.motorcontrollers.remote.TalonFXSWrapper;
{{/inline}}
{{#*inline "device"}}
  // The vendor motor controller object: a Talon FXS with CAN ID {{canId}} on CAN bus {{canPort}}.
  private final TalonFXS talon = new TalonFXS({{canId}}, new CANBus(CANPort.{{canPort}}));
{{/inline}}
{{#*inline "fields"}}
  // The SmartMotorController applies the config to the Talon FXS, which drives one {{motorDisplayName}}.
  // YAMS sets the Talon FXS motor arrangement from the DCMotor.
{{#if dcMotorFromSpecs}}
  // WPILib has no model of the Thrifty Pulsar, so it is built from Thrifty's specs: 12 V, 3.1 N-m and
  // 189 A stalled, and 2.7 A at 7500 RPM free.
{{/if}}
  private final SmartMotorController motor = new TalonFXSWrapper(talon, {{{dcMotor}}}, smcConfig);
{{/inline}}
