{{#*inline "imports"}}
import com.thrifty.core.Motor.MotorType;
import com.thrifty.nova.Nova;
import yams.core.motorcontrollers.local.NovaWrapper;
{{/inline}}
{{#*inline "device"}}
  // The vendor motor controller object: a Thrifty Nova on CAN bus {{canBus}} with CAN ID {{canId}} on CAN bus {{canPort}}.
  private final Nova nova = new Nova({{canBus}}, {{canId}}, MotorType.{{thriftyMotorType}});
{{/inline}}
{{#*inline "fields"}}
  // The SmartMotorController applies the config to the Nova, which drives one {{motorDisplayName}}.
{{#if dcMotorFromSpecs}}
  // WPILib has no model of the Thrifty Pulsar, so it is built from Thrifty's specs: 12 V, 3.1 N-m and
  // 189 A stalled, and 2.7 A at 7500 RPM free.
{{/if}}
  private final SmartMotorController motor = new NovaWrapper(nova, {{{dcMotor}}}, smcConfig);
{{/inline}}
