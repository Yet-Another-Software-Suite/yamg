package first.robot.subsystems;

import static org.wpilib.units.Units.Amps;
import static org.wpilib.units.Units.Degrees;
import static org.wpilib.units.Units.Kilograms;
import static org.wpilib.units.Units.Meters;
import static org.wpilib.units.Units.RadiansPerSecond;
{{#if useProfile}}
import static org.wpilib.units.Units.RadiansPerSecondPerSecond;
{{/if}}
import static org.wpilib.units.Units.Seconds;

{{> imports}}
{{> encoderImports}}
{{> homingImports}}
import org.wpilib.command2.Command;
import org.wpilib.command2.SubsystemBase;
import org.wpilib.command2.button.Trigger;
import org.wpilib.math.controller.ArmFeedforward;
import org.wpilib.math.system.DCMotor;
import org.wpilib.units.measure.Angle;
import yams.commands2.config.SmartMotorControllerConfig;
import yams.commands2.mechanisms.Arm;
import yams.core.gearing.MechanismGearing;
import yams.core.mechanisms.config.ArmConfig;
import yams.core.motorcontrollers.SmartMotorController;
import yams.core.motorcontrollers.enums.ControlMode;
import yams.core.motorcontrollers.enums.MotorMode;
import yams.core.telemetry.enums.TelemetryVerbosity;

/**
 * An arm driven by a {{motorDisplayName}} through a {{controllerDisplayName}}, using YAMS.
 * Generated by YAMG.
 *
 * <p>Angles are measured from horizontal: 0 degrees points the arm straight out, and positive
 * angles raise it.
 */
public class {{className}} extends SubsystemBase {

{{> device}}
{{> encoderFields}}

  // What the motor controller should do: its control mode, gains, gearing and limits.
  private final SmartMotorControllerConfig smcConfig = new SmartMotorControllerConfig(this)
      .withControlMode(ControlMode.CLOSED_LOOP)
      // Feedback constants (PID), in volts per rotation of error, on the real robot and in simulation.
      .withClosedLoopController({{kP}}, {{kI}}, {{kD}})
      .withSimClosedLoopController({{kP}}, {{kI}}, {{kD}})
      // The fastest the closed loop is allowed to move and accelerate the arm.
{{#if useProfile}}
      .withTrapezoidalProfile(RadiansPerSecond.of({{maxVelocity}}), RadiansPerSecondPerSecond.of({{maxAcceleration}}))
{{/if}}
      // Feedforward constants, in volts per rotation per second, on the real robot and in simulation.
      .withFeedforward(new ArmFeedforward({{kS}}, {{kG}}, {{kV}}, {{kA}}))
      .withSimFeedforward(new ArmFeedforward({{kS}}, {{kG}}, {{kV}}, {{kA}}))
      // Gearing from the motor rotor to the arm: {{gearRatio}} motor rotations per arm rotation.
      .withGearing(new MechanismGearing({{gearRatio}}))
      // The arm's length and mass, used by the simulation.
      .withMomentOfInertia(Meters.of({{armLength}}), Kilograms.of({{mass}}))
      .withMotorInverted(false)
      .withZeroPower(MotorMode.{{#if brakeMode}}BRAKE{{else}}COAST{{/if}})
{{#if enableStatorLimit}}
      .withStatorCurrentLimit(Amps.of({{statorCurrentLimit}}))
{{/if}}
{{#if enableSupplyLimit}}
      .withSupplyCurrentLimit(Amps.of({{supplyCurrentLimit}}))
{{/if}}
{{#if enableOpenLoopRamp}}
      .withOpenLoopRampRate(Seconds.of({{openLoopRampRate}}))
{{/if}}
{{#if enableClosedLoopRamp}}
      .withClosedLoopRampRate(Seconds.of({{closedLoopRampRate}}))
{{/if}}
      // Where the arm is when the robot turns on.
{{#if absoluteNative}}
      // Simulation has no encoder, so it starts here. The real robot reads the encoder.
      .withSimStartingPosition(Degrees.of({{startingPosition}}))
{{else}}
      .withStartingPosition(Degrees.of({{startingPosition}}))
{{/if}}
{{#if enableSoftLimits}}
      // The closed loop will not take the arm past these angles.
      .withSoftLimits(Degrees.of({{reverseSoftLimit}}), Degrees.of({{forwardSoftLimit}}))
{{/if}}
{{> encoderConfig}}
      // Telemetry name and how much to publish.
      .withTelemetry("{{className}}Motor", TelemetryVerbosity.HIGH);

{{> fields}}

  private final ArmConfig armConfig = new ArmConfig()
      // The hard stops, used by the simulation.
      .withHardLimits(Degrees.of({{hardLimitMin}}), Degrees.of({{hardLimitMax}}))
      // The length of the arm, used by the simulation.
      .withLength(Meters.of({{armLength}}))
      // Telemetry name and how much to publish.
      .withTelemetry("{{className}}", TelemetryVerbosity.HIGH);

  // The arm mechanism.
  private final Arm arm = new Arm(armConfig, motor);
{{> homingFields}}
{{#if absoluteSeed}}

  public {{className}}() {
{{> encoderSeed}}
  }

{{> encoderMethods}}
{{/if}}

  /** Go to an angle and hold it. This command does not end on its own. */
  public Command run(Angle angle) {
    return arm.run(angle);
  }

  /** Go to an angle, and end once the arm is within the tolerance of it. */
  public Command runTo(Angle angle, Angle tolerance) {
    return arm.runTo(angle, tolerance);
  }

  /** Drive the arm with a duty cycle from -1 to 1. The closed loop is not used. */
  public Command set(double dutyCycle) {
    return arm.set(dutyCycle);
  }

  /** True while the arm is within a tolerance of an angle. */
  public Trigger near(Angle angle, Angle tolerance) {
    return arm.near(angle, tolerance);
  }

{{> homingMethods}}
  @Override
  public void periodic() {
{{> homingPeriodic}}
    // Publishes the arm's telemetry, and applies anything changed through live tuning.
    arm.updateTelemetry();
{{> encoderTelemetry}}
  }

  @Override
  public void simulationPeriodic() {
    // Runs the arm's physics simulation.
    arm.simIterate();
  }
}
