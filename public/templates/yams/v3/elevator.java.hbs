package first.robot.mechanisms;

import static org.wpilib.units.Units.Amps;
{{#if level}}
import static org.wpilib.units.Units.Degrees;
{{/if}}
{{#unless (eq circumferenceUnit "Meters")}}
import static org.wpilib.units.Units.{{circumferenceUnit}};
{{/unless}}
import static org.wpilib.units.Units.Kilograms;
import static org.wpilib.units.Units.Meters;
import static org.wpilib.units.Units.MetersPerSecond;
{{#if useProfile}}
import static org.wpilib.units.Units.MetersPerSecondPerSecond;
{{/if}}
import static org.wpilib.units.Units.Seconds;

{{> imports}}
import org.wpilib.command3.Command;
import org.wpilib.command3.Mechanism;
import org.wpilib.command3.Trigger;
import org.wpilib.math.controller.ElevatorFeedforward;
import org.wpilib.math.system.DCMotor;
import org.wpilib.units.measure.Distance;
import yams.commands3.config.SmartMotorControllerConfig;
import yams.commands3.mechanisms.Elevator;
import yams.core.gearing.MechanismGearing;
import yams.core.mechanisms.config.ElevatorConfig;
import yams.core.motorcontrollers.SmartMotorController;
import yams.core.motorcontrollers.enums.ControlMode;
import yams.core.motorcontrollers.enums.MotorMode;
import yams.core.telemetry.enums.TelemetryVerbosity;

/**
 * An elevator driven by a {{motorDisplayName}} through a {{controllerDisplayName}}, using YAMS.
 * Generated by YAMG.
{{#if rackAndPinion}}
 *
 * <p>A pinion on the gearbox runs along a toothed rack.{{#if level}} The slide is level, so gravity
 * does not act on it and kG is 0.{{/if}}
{{/if}}
 */
public class {{className}} implements Mechanism {

{{> device}}

  // What the motor controller should do: its control mode, gains, gearing and limits.
  private final SmartMotorControllerConfig smcConfig = new SmartMotorControllerConfig(this)
      .withControlMode(ControlMode.CLOSED_LOOP)
      // How far the {{#if rackAndPinion}}rack{{else}}chain, belt or rope{{/if}} moves for each turn of the {{driveNoun}}: {{driveDescription}}.
      // With this set, the gains and limits are in meters.
      {{yamsDriveCall}}
      // Feedback constants (PID), in volts per meter of error, on the real robot and in simulation.
      .withClosedLoopController({{kP}}, {{kI}}, {{kD}})
      .withSimClosedLoopController({{kP}}, {{kI}}, {{kD}})
      // The fastest the closed loop is allowed to move and accelerate the elevator.
{{#if useProfile}}
      .withTrapezoidalProfile(MetersPerSecond.of({{maxVelocity}}), MetersPerSecondPerSecond.of({{maxAcceleration}}))
{{/if}}
      // Feedforward constants, in volts per meter per second, on the real robot and in simulation.
      .withFeedforward(new ElevatorFeedforward({{kS}}, {{kG}}, {{kV}}, {{kA}}))
      .withSimFeedforward(new ElevatorFeedforward({{kS}}, {{kG}}, {{kV}}, {{kA}}))
      // Gearing from the motor rotor to the {{driveNoun}}: {{gearRatio}} motor rotations per turn of it.
      .withGearing(new MechanismGearing({{gearRatio}}))
{{#if cascade}}
      // The elevator is a {{cascadeStages}} stage cascade: each stage moves as far again as the one below
      // it, so the carriage moves {{cascadeStages}} times as far as the chain or belt. This divides the
      // gearing above by the stages, so it has to come after it.
      .withCascadingElevatorStages({{cascadeStages}})
{{/if}}
      .withMotorInverted(false)
      .withZeroPower(MotorMode.{{#if brakeMode}}BRAKE{{else}}COAST{{/if}})
{{#if enableStatorLimit}}
      .withStatorCurrentLimit(Amps.of({{statorCurrentLimit}}))
{{/if}}
{{#if enableSupplyLimit}}
      .withSupplyCurrentLimit(Amps.of({{supplyCurrentLimit}}))
{{/if}}
{{#if enableOpenLoopRamp}}
      .withOpenLoopRampRate(Seconds.of({{openLoopRampRate}}))
{{/if}}
{{#if enableClosedLoopRamp}}
      .withClosedLoopRampRate(Seconds.of({{closedLoopRampRate}}))
{{/if}}
      // Where the carriage is when the robot turns on.
      .withStartingPosition(Meters.of({{startingHeight}}))
{{#if enableSoftLimits}}
      // The closed loop will not take the carriage past these heights.
      .withSoftLimits(Meters.of({{reverseSoftLimit}}), Meters.of({{forwardSoftLimit}}))
{{/if}}
      // Telemetry name and how much to publish.
      .withTelemetry("{{className}}Motor", TelemetryVerbosity.HIGH);

{{> fields}}

  private final ElevatorConfig elevatorConfig = new ElevatorConfig()
{{#if level}}
      // The slide is level: drawn flat, with no gravity in the simulation.
      .withAngle(Degrees.of(0))
      .withHorizontalElevator()
{{/if}}
      // The hard stops, used by the simulation.
      .withHardLimits(Meters.of({{hardLimitMin}}), Meters.of({{hardLimitMax}}))
      // The mass of the carriage, used by the simulation.
      .withCarriageWeight(Kilograms.of({{mass}}))
      // Telemetry name and how much to publish.
      .withTelemetry("{{className}}", TelemetryVerbosity.HIGH);

  // The elevator mechanism.
  private final Elevator elevator = new Elevator(elevatorConfig, motor);

  /** Go to a height and hold it. This command does not end on its own. */
  public Command setHeight(Distance height) {
    return elevator.setHeight(height);
  }

  /** Go to a height, and end once the carriage is within the tolerance of it. */
  public Command moveTo(Distance height, Distance tolerance) {
    return elevator.runTo(height, tolerance);
  }

  /** Drive the elevator with a duty cycle from -1 to 1. The closed loop is not used. */
  public Command set(double dutyCycle) {
    return elevator.set(dutyCycle);
  }

  /** True while the carriage is within a tolerance of a height. */
  public Trigger near(Distance height, Distance tolerance) {
    return elevator.near(height, tolerance);
  }

  /** Hold a height at the lowest priority, so that any other elevator command can interrupt it. */
  public Command hold(Distance height) {
    return run(coroutine -> coroutine.await(elevator.setHeight(height)))
        .withPriority(Command.LOWEST_PRIORITY)
        .named("{{className}} Hold");
  }

  /** Call this from Robot.robotPeriodic(), before the scheduler runs. */
  public void periodic() {
    // Publishes the elevator's telemetry, and applies anything changed through live tuning.
    elevator.updateTelemetry();
  }

  /** Call this from Robot.simulationPeriodic(). */
  public void simulationPeriodic() {
    // Runs the elevator's physics simulation.
    elevator.simIterate();
  }
}
