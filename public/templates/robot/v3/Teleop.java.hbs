package first.robot;

import static org.wpilib.units.Units.{{bindingUnit}};

import org.wpilib.opmode.OpMode;
import org.wpilib.opmode.Teleop;

/**
 * A teleop op mode for the {{className}}, generated by YAMG. Pick it on the driver station to drive
 * the {{mechanismNoun}} from the gamepad. The template's ExampleTeleop is still there as well.
 */
@Teleop(name = "{{teleopName}}", description = "Drive the {{mechanismNoun}} from the gamepad")
public class {{className}}Teleop implements OpMode {
  public {{className}}Teleop(Robot robot) {
    // {{targetDescription}}
    robot.exampleController.faceDown().whileTrue(robot.{{mechanismField}}.{{targetA}});
    robot.exampleController.faceRight().whileTrue(robot.{{mechanismField}}.{{targetB}});
    // Drive the {{mechanismNoun}} with a duty cycle while the left (X) or top (Y) face button is held.
    robot.exampleController.faceLeft().whileTrue(robot.{{mechanismField}}.set(0.3));
    robot.exampleController.faceUp().whileTrue(robot.{{mechanismField}}.set(-0.3));
  }
}
