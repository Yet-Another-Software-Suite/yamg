import com.thrifty.core.Motor.FeedbackSensorType;
{{/if}}
import com.thrifty.nova.NovaConfig;
{{/if}}
{{/if}}
{{#if hasDutyCycleEncoder}}
import org.wpilib.hardware.rotation.DutyCycleEncoder;
{{/if}}
