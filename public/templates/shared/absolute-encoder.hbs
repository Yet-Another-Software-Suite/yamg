{{#*inline "encoderFields"}}
{{#if absoluteEncoder}}
  // The {{encoderDisplayName}} {{encoderWhere}}, which knows where the {{mechanismNoun}} is when
  // the robot turns on.
{{#unless absoluteNative}}
  // What it reads with the {{mechanismNoun}} at zero.{{#if encoderInverted}} It counts down as the {{mechanismNoun}} moves in its positive direction.{{/if}}
  private static final Angle ABSOLUTE_ENCODER_OFFSET = Degrees.of({{encoderOffset}});
  /** Encoder rotations per {{mechanismNoun}} rotation. */
  private static final double ABSOLUTE_ENCODER_RATIO = {{encoderRatio}};
  /** The middle of the travel between the hard stops. The encoder's reading is taken within half an encoder turn of it. */
  private static final Angle ABSOLUTE_TRAVEL_MIDDLE = Degrees.of({{travelMiddle}});
{{/unless}}
{{/if}}
{{#if crt}}
  // The turret's angle when the robot turns on comes from two absolute encoders, on pinions with
  // {{crtA.pinionTeeth}} and {{crtB.pinionTeeth}} teeth that both mesh with a {{sharedGearTeeth}} tooth gear. Neither knows the angle on its
  // own, but the pair of readings is unique over the turret's travel (the Chinese Remainder Theorem).
  /** Rotations of the {{sharedGearTeeth}} tooth gear per turret rotation. */
  private static final double SHARED_GEAR_RATIO = {{sharedGearRatio}};
  // What each encoder reads with the turret at zero.
  private static final Angle CRT_ENCODER_A_OFFSET = Degrees.of({{crtA.offset}});
  private static final Angle CRT_ENCODER_B_OFFSET = Degrees.of({{crtB.offset}});
{{#if (eq output "yams")}}
  // The shared gear's teeth, then each encoder pinion's teeth.
  private final EasyCRT crt = new EasyCRT({{sharedGearTeeth}}, {{crtA.pinionTeeth}}, {{crtB.pinionTeeth}});
{{/if}}
  private final Alert crtAlert = new Alert(
      "{{className}}", "The turret encoders do not agree on an angle. Check their offsets and inversion.", Alert.Level.HIGH);
{{/if}}
{{#each systemCoreEncoders}}
{{#if cancoder}}
  // A {{displayName}} with CAN ID {{canId}} on CAN bus {{canPort}}.
  private final CANcoder {{field}} = new CANcoder({{canId}}, new CANBus(CANPort.{{canPort}}));
{{else if candi}}
  // A CANdi with CAN ID {{canId}} on CAN bus {{canPort}}, with a {{displayName}} on its PWM1 input.
  private final CANdi {{field}} = new CANdi({{canId}}, new CANBus(CANPort.{{canPort}}));
{{else}}
  // A {{displayName}} on SystemCore Smart IO channel {{channel}}. It reads 0 to 1 rotation.
  private final DutyCycleEncoder {{field}} = new DutyCycleEncoder({{channel}});
{{/if}}
{{/each}}
{{/inline}}
{{#*inline "encoderConfig"}}
{{#if novaDataPort}}
      // The encoder plugged into the Nova's data port.
      .withVendorConfig(NovaConfig.absoluteEncoderType(AbsoluteEncoderType.{{novaEncoderType}}))
{{/if}}
{{#if candiFeedback}}
      // The Talon reads the encoder on the CANdi's PWM1 input.
{{#if (eq motorControllerType "TalonFX")}}
      .withVendorConfig(new TalonFXConfiguration()
          .withFeedback(new FeedbackConfigs().withFeedbackSensorSource(FeedbackSensorSourceValue.SyncCANdiPWM1)))
{{else}}
      .withVendorConfig(new TalonFXSConfiguration()
          .withExternalFeedback(new ExternalFeedbackConfigs()
              .withExternalFeedbackSensorSource(ExternalFeedbackSensorSourceValue.SyncCANdiPWM1)))
{{/if}}
{{/if}}
{{#if absoluteNative}}
      // The {{encoderDisplayName}} {{encoderWhere}} tells the motor controller where the
      // {{mechanismNoun}} is, and is the closed loop's feedback.
      // YAMS publishes what it reads as {{className}}Motor/externalencoder/position. Set the zero
      // offset to 0, move the {{mechanismNoun}} to zero, and use that reading as the offset. If it goes
      // the opposite way to the motor's position, invert the encoder.
      .withExternalEncoder({{yamsExternalEncoder}})
      .withUseExternalFeedbackEncoder(true)
      .withExternalEncoderInverted({{encoderInverted}})
{{#if encoderGeared}}
      // The encoder turns {{encoderRatio}} times per {{mechanismNoun}} rotation.
      .withExternalEncoderGearing({{encoderRatio}})
{{/if}}
      // What the encoder reads with the {{mechanismNoun}} at zero{{#if encoderGeared}}, in {{mechanismNoun}} degrees{{/if}}.
      .withExternalEncoderZeroOffset(Degrees.of({{nativeOffset}}))
      // The encoder reads {{#if (eq discontinuity "0.5")}}-180 to 180{{else}}0 to 360{{/if}} degrees from its zero, so it does not wrap between the hard stops.
      .withExternalEncoderDiscontinuityPoint(Rotations.of({{discontinuity}}))
{{/if}}
{{/inline}}
{{#*inline "encoderSeed"}}
{{#if absoluteSeed}}
    if (RobotBase.isReal()) {
{{#if novaDataPort}}
{{#unless (eq output "yams")}}
      motor.configure(NovaConfig.absoluteEncoderType(AbsoluteEncoderType.{{novaEncoderType}}));
{{/unless}}
{{/if}}
{{#if sparkMaxDataPort}}
      // Read the absolute encoder on the data port, rather than an alternate encoder.
      SparkMaxConfig dataPortConfig = new SparkMaxConfig();
      dataPortConfig.absoluteEncoder.setSparkMaxDataPortConfig();
      motor.configure(dataPortConfig, ResetMode.kNoResetSafeParameters, PersistMode.kPersistParameters);
{{/if}}
{{#if crt}}
      // Start the motor's encoder at the angle the two encoders agree on. Simulation has no
      // encoders, so there the turret starts at its starting position.
      Optional<Angle> crtAngle = getCrtAngle({{crtA.startup}}, {{crtB.startup}});
      crtAngle.ifPresent(angle -> {{seedCall}}(angle));
      crtAlert.set(crtAngle.isEmpty());
{{else}}
      // Start the motor's encoder where the absolute encoder says the {{mechanismNoun}} is.
      // Simulation has no encoder, so there it starts at its starting position.
      {{seedCall}}(getAbsoluteAngle({{encoderReading}}));
{{/if}}
    }
{{/if}}
{{/inline}}
{{#*inline "encoderMethods"}}
{{#if absoluteSeed}}
{{#unless crt}}
  /**
   * Where the absolute encoder says the {{mechanismNoun}} is. The encoder only knows where it is
   * within one of its own turns, so this is the angle within half an encoder turn of the middle of
   * the travel.
   */
  private Angle getAbsoluteAngle(Angle reading) {
    // How far the encoder has turned from where it reads with the {{mechanismNoun}} at zero.
    Angle fromZero = {{#if encoderInverted}}ABSOLUTE_ENCODER_OFFSET.minus(reading){{else}}reading.minus(ABSOLUTE_ENCODER_OFFSET){{/if}};
    // How far that is from the middle of the travel, as an encoder angle from -0.5 to 0.5 rotations.
    double fromMiddle = MathUtil.inputModulus(
        fromZero.minus(ABSOLUTE_TRAVEL_MIDDLE.times(ABSOLUTE_ENCODER_RATIO)).in(Rotations), -0.5, 0.5);
    return ABSOLUTE_TRAVEL_MIDDLE.plus(Rotations.of(fromMiddle).div(ABSOLUTE_ENCODER_RATIO));
  }

  /**
   * What the absolute encoder reads, before the offset and inversion. Move the {{mechanismNoun}} to
   * zero, and this is the offset.
   */
{{#if useEpilogue}}
  @Logged(name = "AbsoluteEncoder/Reading")
{{/if}}
  public Angle getAbsoluteEncoderReading() {
    return {{encoderLiveReading}};
  }

  /**
   * Where the absolute encoder says the {{mechanismNoun}} is. It should follow the {{mechanismNoun}}'s
   * angle. If it goes the opposite way, the encoder needs inverting.
   */
{{#if useEpilogue}}
  @Logged(name = "AbsoluteEncoder/Angle")
{{/if}}
  public Angle getAbsoluteEncoderAngle() {
    return getAbsoluteAngle(getAbsoluteEncoderReading());
  }
{{/unless}}
{{/if}}
{{#if crt}}
  /**
   * Where the two encoders say the turret is, or empty if they do not agree on one angle. Read it
   * while the turret is still, since the two encoders are read one after the other.
   */
  private Optional<Angle> getCrtAngle(Angle readingA, Angle readingB) {
    // Each reading from where it is with the turret at zero, counting up as the turret turns positive.
    Angle encoderA = {{#if crtA.inverted}}CRT_ENCODER_A_OFFSET.minus(readingA){{else}}readingA.minus(CRT_ENCODER_A_OFFSET){{/if}};
    Angle encoderB = {{#if crtB.inverted}}CRT_ENCODER_B_OFFSET.minus(readingB){{else}}readingB.minus(CRT_ENCODER_B_OFFSET){{/if}};
    // The pinions mesh with the {{sharedGearTeeth}} tooth gear, so the solve is for its angle, over its travel.
    Angle sharedGearMin = Degrees.of({{hardLimitMin}}).times(SHARED_GEAR_RATIO);
    Angle sharedGearMax = Degrees.of({{hardLimitMax}}).times(SHARED_GEAR_RATIO);
{{#if (eq output "yams")}}
    return crt.solve(encoderA, encoderB, sharedGearMin, sharedGearMax)
        .map(sharedGearAngle -> sharedGearAngle.div(SHARED_GEAR_RATIO));
{{else}}
    return solveCrt(encoderA, encoderB, sharedGearMin, sharedGearMax)
        .map(sharedGearAngle -> sharedGearAngle.div(SHARED_GEAR_RATIO));
{{/if}}
  }

  /** What encoder A reads, before the offset and inversion. With the turret at zero, this is its offset. */
{{#if useEpilogue}}
  @Logged(name = "CRT/EncoderA")
{{/if}}
  public Angle getCrtEncoderAReading() {
    return {{crtA.live}};
  }

  /** What encoder B reads, before the offset and inversion. With the turret at zero, this is its offset. */
{{#if useEpilogue}}
  @Logged(name = "CRT/EncoderB")
{{/if}}
  public Angle getCrtEncoderBReading() {
    return {{crtB.live}};
  }

  /**
   * Where the two encoders say the turret is, or NaN degrees if they do not agree. It should follow
   * the turret's angle while the turret is still. Each encoder's reading should go up as the turret
   * turns positive once it is inverted, or it needs inverting the other way.
   */
{{#if useEpilogue}}
  @Logged(name = "CRT/Angle")
{{/if}}
  public Angle getCrtTurretAngle() {
    return getCrtAngle(getCrtEncoderAReading(), getCrtEncoderBReading()).orElse(Degrees.of(Double.NaN));
  }
{{#unless (eq output "yams")}}

  // Encoder A's pinion turns once every {{crtA.pinionTeeth}} teeth of the {{sharedGearTeeth}} tooth gear, and encoder B's every
  // {{crtB.pinionTeeth}}, so each encoder knows which tooth of the gear is at its pinion, give or take whole
  // pinion turns. The two together know it over {{crtA.pinionTeeth}} x {{crtB.pinionTeeth}} = {{crtModulus}} teeth.
  private static final long PINION_A_TEETH = {{crtA.pinionTeeth}};
  private static final long PINION_B_TEETH = {{crtB.pinionTeeth}};
  private static final long CRT_MODULUS = {{crtModulus}};
  // The Chinese Remainder Theorem's basis: {{crtBasisA}} is 1 tooth past a whole turn of pinion A and a
  // whole number of turns of pinion B, and {{crtBasisB}} the other way round.
  private static final long CRT_BASIS_A = {{crtBasisA}};
  private static final long CRT_BASIS_B = {{crtBasisB}};
  private static final double SHARED_GEAR_TEETH = {{sharedGearTeeth}}.0;

  /**
   * The angle of the {{sharedGearTeeth}} tooth gear from the two encoder readings, or empty if the
   * readings do not agree or it is outside the travel. Adapted from FRC Team 8114's 2026 turret
   * (BSD 3-Clause): try rounding each encoder's tooth both ways, solve each with the Chinese
   * Remainder Theorem, and keep the position that best matches both readings.
   *
   * <p>Each candidate is scored by its whole position, the tooth plus the fraction of a tooth from
   * encoder B. Scoring by the tooth alone ties a right and a wrong candidate whenever the gear is
   * half a tooth between teeth, and the wrong one is a whole CRT range away.
   */
  private static Optional<Angle> solveCrt(Angle encoderA, Angle encoderB, Angle min, Angle max) {
    // Which tooth of the gear is at each pinion, as a fraction of a pinion turn's worth of teeth.
    double rawA = encoderA.in(Rotations) * PINION_A_TEETH;
    double rawB = encoderB.in(Rotations) * PINION_B_TEETH;
    long floorA = (long) Math.floor(rawA);
    long floorB = (long) Math.floor(rawB);
    // The travel in teeth, with half a tooth either side so that rounding at the ends still fits.
    double minTeeth = min.in(Rotations) * SHARED_GEAR_TEETH - 0.5;
    double maxTeeth = max.in(Rotations) * SHARED_GEAR_TEETH + 0.5;

    double bestError = Double.MAX_VALUE;
    double bestTeeth = Double.NaN;
    for (int i = 0; i < 2; i++) {
      long toothA = Math.floorMod(floorA + i, PINION_A_TEETH);
      for (int j = 0; j < 2; j++) {
        long toothB = Math.floorMod(floorB + j, PINION_B_TEETH);
        // The one tooth within CRT_MODULUS that is toothA past pinion A's turns and toothB past pinion B's.
        long residue = Math.floorMod(toothA * CRT_BASIS_A + toothB * CRT_BASIS_B, CRT_MODULUS);
        // Move it by whole CRT_MODULUS steps to the first one at or above the bottom of the travel.
        long tooth = residue + CRT_MODULUS * (long) Math.ceil((minTeeth - residue) / CRT_MODULUS);
        if (tooth > maxTeeth) {
          continue;
        }
        // The gear's position: that tooth, plus the fraction of a tooth past it from encoder B.
        double teeth = tooth + MathUtil.inputModulus(rawB - Math.floorMod(tooth, PINION_B_TEETH), -0.5, 0.5);
        // How far each reading is from what it would be with the gear there, wrapped around its pinion's teeth.
        double errorA = Math.abs(MathUtil.inputModulus(rawA - teeth, -PINION_A_TEETH / 2.0, PINION_A_TEETH / 2.0));
        double errorB = Math.abs(MathUtil.inputModulus(rawB - teeth, -PINION_B_TEETH / 2.0, PINION_B_TEETH / 2.0));
        double error = errorA * errorA + errorB * errorB;
        if (error < bestError) {
          bestError = error;
          bestTeeth = teeth;
        }
      }
    }
    // Readings half a tooth or more apart do not agree on one position: check the offsets and inversion.
    if (bestError >= 0.25 || bestTeeth < minTeeth || bestTeeth > maxTeeth) {
      return Optional.empty();
    }
    return Optional.of(Rotations.of(bestTeeth / SHARED_GEAR_TEETH));
  }
{{/unless}}
{{/if}}
{{#unless (eq output "yams")}}
