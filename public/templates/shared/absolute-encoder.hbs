{{#*inline "encoderTelemetry"}}
{{#unless useEpilogue}}
{{#if absoluteSeed}}
{{#if crt}}
    // The CRT encoders' readings set their offsets, and the solved angle shows whether they agree.
    Telemetry.log("{{ntKey}}/CRT/EncoderA", getCrtEncoderAReading());
    Telemetry.log("{{ntKey}}/CRT/EncoderB", getCrtEncoderBReading());
    Telemetry.log("{{ntKey}}/CRT/Angle", getCrtTurretAngle());
{{else}}
    // The encoder's reading sets its offset, and its angle shows whether it needs inverting.
    Telemetry.log("{{ntKey}}/AbsoluteEncoder/Reading", getAbsoluteEncoderReading());
    Telemetry.log("{{ntKey}}/AbsoluteEncoder/Angle", getAbsoluteEncoderAngle());
{{/if}}
{{/if}}
