{{#*inline "homingImports"}}
{{#if homing}}
{{#if (eq commands "v2")}}
import org.wpilib.command2.Commands;
{{/if}}
import org.wpilib.hardware.discrete.DigitalInput;
{{#if (eq output "yams")}}
{{#unless absoluteSeed}}
import org.wpilib.telemetry.Telemetry;
{{/unless}}
import yams.core.mechanisms.config.SensorConfig;
import yams.core.motorcontrollers.simulation.Sensor;
{{else}}
import org.wpilib.simulation.DIOSim;
{{/if}}
{{/if}}
{{/inline}}
{{#*inline "homingFields"}}
{{#if homing}}

  // The homing switches, on SystemCore Smart IO ports. The {{mechanismNoun}} presses one at the end of its
  // travel, which holds the motor's encoder at that end: see the constructor.
{{#each homingSwitches}}
  private final DigitalInput {{field}}Input = new DigitalInput({{channel}});
{{/each}}
{{#if (eq output "yams")}}
  // YAMS Sensors read the switches on the real robot. In simulation, each is pressed as the real one
  // is, while the simulated {{mechanismNoun}} is at the switch's hard stop, and can also be pressed from the Sim GUI.
{{#each homingSwitches}}
  private final Sensor {{field}} = new SensorConfig("{{../className}}{{name}}")
      .withField("Pressed", () -> {{#if pressedHigh}}{{field}}Input.get(){{else}}!{{field}}Input.get(){{/if}}, false)
      .withSimulatedValue("Pressed", () -> motor.getSimSupplier()
          .map(sim -> {{../homingMeasurement}}.{{compare}}({{pressedAt}}))
          .orElse(false), true)
      .getSensor();
{{/each}}
{{else}}
  // In simulation, each switch is pressed as the real one is: while the {{mechanismNoun}} is at its hard stop.
{{#each homingSwitches}}
  private DIOSim {{field}}Sim;
{{/each}}
{{/if}}
{{/if}}
{{/inline}}
{{#*inline "homingMethods"}}
{{#if homing}}
{{#each homingSwitches}}
  /** True while the {{../mechanismNoun}} presses the {{end}} homing switch. */
{{#if ../useEpilogue}}
  @Logged(name = "{{name}}")
{{/if}}
  public boolean is{{name}}Pressed() {
{{#if (eq ../output "yams")}}
    return {{field}}.getAsBoolean("Pressed");
{{else}}
    // The input reads {{#if pressedHigh}}high{{else}}low{{/if}} while the switch is pressed.
    return {{#if pressedHigh}}{{field}}Input.get(){{else}}!{{field}}Input.get(){{/if}};
{{/if}}
  }

{{/each}}
{{#unless (eq output "yams")}}
{{#unless absoluteSeed}}
{{#if (eq mechanismType "Elevator")}}
  /** Set the motor's encoder to a position of the {{driveNoun}}, in turns. */
{{else}}
  /** Set the motor's encoder to a {{mechanismNoun}} angle. */
{{/if}}
  private void setEncoderPosition(Angle mechanismPosition) {
{{> setEncoderPosition}}
  }

{{/unless}}
{{/unless}}
{{/if}}
{{/inline}}
{{#*inline "homingPeriodic"}}
{{#if homing}}
{{#unless useEpilogue}}
{{#each homingSwitches}}
    Telemetry.log("{{../ntKey}}/{{name}}", is{{name}}Pressed());
{{/each}}
{{/unless}}
{{/if}}
{{/inline}}
{{#*inline "homingBind"}}
{{#if homing}}
    // Home on each switch while the {{mechanismNoun}} presses it: the trigger keeps the motor's encoder at
    // the end of the travel the switch is at, every loop the switch is held.
{{#each homingSwitches}}
    new Trigger(this::is{{name}}Pressed)
{{#if (eq ../commands "v2")}}
        .whileTrue(Commands.run(() -> {{../homingSeedCall}}({{position}})).withName("{{../className}} Home {{name}}"));
{{else}}
        .whileTrue(Command.noRequirements(coroutine -> {
          while (true) {
            {{../homingSeedCall}}({{position}});
            coroutine.yield();
          }
        }).named("{{../className}} Home {{name}}"));
{{/if}}
{{/each}}
{{/if}}
{{/inline}}
{{#*inline "homingSimInit"}}
{{#if homing}}
{{#each homingSwitches}}
      {{field}}Sim = new DIOSim({{field}}Input);
{{/each}}
{{/if}}
{{/inline}}
{{#*inline "homingSim"}}
{{#if homing}}
    // Press the homing switches while the simulated {{mechanismNoun}} is at a hard stop.
{{#each homingSwitches}}
    {{field}}Sim.setValue({{#unless pressedHigh}}!{{/unless}}{{../homingSimMeasurement}}.{{compare}}({{pressedAt}}));
{{/each}}
{{/if}}
{{/inline}}
