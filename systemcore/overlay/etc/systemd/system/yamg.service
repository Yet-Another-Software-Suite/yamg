[Unit]
Description=yamg web server (socket activated)
Requires=yamg.socket
After=yamg.socket

[Service]
Type=simple
ExecStart=/usr/bin/env python3 /usr/local/bin/yamg/server.py /usr/share/yamg/www
Restart=no
KillMode=mixed
TimeoutStopSec=3

DynamicUser=true
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

# Started by the socket unit only
[Install]
